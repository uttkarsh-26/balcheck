---
/**
 * VideoHeroBanner.astro — full-width video background hero with overlay text.
 * Same pattern as kiststatus.in's VideoHeroBanner.
 * Video is muted/loop and only plays while in view (mobile data friendly).
 */
interface Props {
  src: string;
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  poster?: string;
  headingLevel?: 1 | 2;
  /** ISO 8601 uploadDate for VideoObject schema (full datetime with timezone).
   *  Defaults to the date the hero video was first published on the site. */
  uploadDate?: string;
}
const { src, title, subtitle, ctaText, ctaHref, poster, headingLevel = 1, uploadDate = '2026-06-22T18:34:39+05:30' } = Astro.props;
const HeadingTag = `h${headingLevel}` as 'h1' | 'h2';

const siteOrigin = Astro.url.origin;
const resolveUrl = (p: string) => (p.startsWith('http') ? p : `${siteOrigin}${p.startsWith('/') ? '' : '/'}${p}`);
const videoUrl = resolveUrl(src);
const posterUrl = poster ? resolveUrl(poster) : undefined;
const thumbnailUrl = posterUrl ?? videoUrl;
---

<section class="relative my-6 aspect-[16/10] min-h-[220px] w-full overflow-hidden rounded-2xl bg-gray-900 shadow-lg ring-1 ring-black/10 sm:my-8 sm:aspect-[2/1] sm:min-h-[280px] lg:aspect-[5/2]">
  {/* Video background */}
  <div class="absolute inset-0 h-full w-full">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={src}
      poster={posterUrl}
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      disablepictureinpicture
    >
      Your browser does not support the video tag.
    </video>
    {/* Scrim for text readability — lighter so the media itself stays visible */}
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900/75 via-gray-900/40 to-gray-900/20"></div>
  </div>

  {/* Foreground content */}
  <div class="relative z-10 flex h-full items-center justify-center px-4 py-8 text-center text-white sm:px-6 md:py-10">
    <div class="max-w-4xl">
      <HeadingTag class="text-2xl font-bold leading-tight drop-shadow-lg sm:text-3xl md:text-5xl">
        {title}
      </HeadingTag>
      {subtitle && (
        <p class="mx-auto mt-3 max-w-2xl text-sm font-medium leading-snug text-white drop-shadow-md sm:text-lg md:text-xl">
          {subtitle}
        </p>
      )}
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="mt-5 inline-flex min-h-12 items-center justify-center rounded-full bg-gradient-to-br from-brand-600 to-brand-700 px-7 py-3 text-base font-semibold text-white shadow-lg transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:px-8 sm:text-lg"
        >
          {ctaText}
        </a>
      )}
    </div>
  </div>

  {/* Play the hero video only while it is on screen — saves mobile data */}
  <script>
    const video = document.currentScript?.previousElementSibling?.querySelector('video');
    if (video) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            video.play().catch(() => {/* autoplay blocked — poster stays */});
          } else {
            video.pause();
          }
        }
      }, { threshold: 0.25 });
      observer.observe(video);
    }
  </script>

  {/* VideoObject schema for SEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: title,
    description: subtitle ?? title,
    uploadDate,
    thumbnailUrl,
    contentUrl: videoUrl,
    duration: 'PT6S',
    inLanguage: 'hi',
    isAccessibleForFree: true,
    publisher: {
      '@type': 'Organization',
      name: 'BalCheck.in',
      logo: { '@type': 'ImageObject', url: `${siteOrigin}/favicon.svg` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.toString() },
  })} />
</section>
