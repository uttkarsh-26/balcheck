---
/**
 * The pilot ATM-PIN procedure block.
 *
 * Rendered only for banks that carry a record in `src/data/atm-pin-guides.ts`
 * — today the two approved pilot pages (psb, odisha-grameen). Every string
 * below comes from that record, which in turn is traceable to the bank's own
 * official page or PDF read on `checkedOn`.
 *
 * Why this is a component and not inline template prose: the pilot's contract
 * is "publish only what the cited source documents, and say so where it does
 * not". That is a per-bank data question, so the rendering is data-driven from
 * one record instead of hard-coded per page.
 *
 * Deliberately absent, on purpose:
 * - no form, input or credential ask (this page collects nothing);
 * - no fee claim (no cited source states one);
 * - no channel list beyond the one the source documents.
 */
import { ATM_PIN_SAFETY_WARNING, type AtmPinGuide } from '../data/atm-pin-guides';
import type { Bank } from '../data/banks';

interface Props {
  guide: AtmPinGuide;
  bank: Bank;
}

const { guide, bank } = Astro.props;

const sectionClass = 'mb-6 rounded-xl border border-gray-200 bg-white p-5';
const headingClass = 'text-h2 font-bold text-gray-900 mb-3';
const subHeadingClass = 'font-semibold text-gray-900 mt-4 mb-2';
const bodyClass = 'text-sm leading-relaxed text-gray-700';
const listClass = 'list-disc space-y-1 pl-5 text-sm leading-relaxed text-gray-700 marker:text-gray-400';
---

<section class={sectionClass} data-testid="atm-pin-guide">
  <h2 class={headingClass}>📌 आधिकारिक तरीका — {guide.channel}</h2>
  <p class={`${bodyClass} mb-4`}>{guide.summary}</p>

  <a
    href={guide.officialEntry.url}
    target="_blank"
    rel="noopener noreferrer"
    data-testid="atm-pin-official-entry"
    class="mb-4 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white hover:bg-brand-700"
  >
    {guide.officialEntry.label} <span aria-hidden="true">→</span>
  </a>

  {
    guide.contextNote && (
      <p class={`${bodyClass} mb-4 rounded-lg bg-gray-50 p-3`} data-testid="atm-pin-context-note">
        {guide.contextNote.text}{' '}
        <a
          href={guide.contextNote.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand-700 underline"
        >
          (स्रोत खोलें)
        </a>
      </p>
    )
  }

  <h3 class={subHeadingClass}>ज़रूरी शर्तें</h3>
  <ul class={listClass} data-testid="atm-pin-guide-prerequisites">
    {guide.prerequisites.map((item) => <li>{item}</li>)}
  </ul>

  <h3 class={subHeadingClass}>चरण दर चरण ({guide.steps.length} चरण)</h3>
  <ol class="space-y-2 text-sm leading-relaxed text-gray-700" data-testid="atm-pin-guide-steps">
    {
      guide.steps.map((step, index) => (
        <li class="flex gap-3">
          <span
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <span>
            <strong class="text-gray-900">{step.label}:</strong> {step.detail}
          </span>
        </li>
      ))
    }
  </ol>

  <h3 class={subHeadingClass}>अगर दिक़्कत आए</h3>
  <dl class="space-y-3" data-testid="atm-pin-troubleshooting">
    {
      guide.troubleshooting.map((item) => (
        <div>
          <dt class="text-sm font-semibold text-gray-900">{item.q}</dt>
          <dd class={`${bodyClass} mt-0.5`}>{item.a}</dd>
        </div>
      ))
    }
  </dl>

  <h3 class={subHeadingClass}>यह आधिकारिक स्रोत क्या नहीं बताता</h3>
  <ul class={listClass} data-testid="atm-pin-undocumented">
    {guide.undocumented.map((item) => <li>{item}</li>)}
  </ul>

  <p
    class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm leading-relaxed font-semibold text-red-900"
    data-testid="atm-pin-safety-warning"
  >
    🔒 {ATM_PIN_SAFETY_WARNING}
  </p>

  {
    /*
      Scoped separately from RecordEvidence: that block cites where the phone
      NUMBERS in this page's registry record came from, this one cites where the
      ATM-PIN PROCEDURE above was read from. Two different subjects, two blocks,
      two dates — never one label standing in for both.
    */
  }
  <div
    class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4"
    data-testid="atm-pin-procedure-source"
  >
    <h3 class="font-semibold text-emerald-950 mb-2">📄 ATM-PIN procedure का स्रोत</h3>
    <p class="text-sm leading-relaxed text-emerald-900">
      <strong>{guide.sourceLabel}</strong>
    </p>
    <p class="mt-1 text-sm leading-relaxed text-emerald-900">
      <a
        href={guide.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline"
        data-testid="atm-pin-procedure-source-link"
      >
        आधिकारिक स्रोत खोलें
      </a>
    </p>
    <p class="mt-1 text-sm leading-relaxed text-emerald-900">
      स्रोत पढ़ा गया: <time datetime={guide.checkedOn} class="font-semibold">{guide.checkedOn}</time>
    </p>
    <p class="mt-2 text-xs leading-relaxed text-emerald-800">
      यह block सिर्फ़ इस page के ATM-PIN procedure के source के बारे में है। नीचे दिया "स्रोत और अंतिम
      सत्यापन" block बैंक के phone numbers के record के बारे में है — दोनों अलग-अलग विषय हैं।{' '}
      {bank.shortName} के आधिकारिक स्रोत बदल सकते हैं; final confirmation के लिए बैंक की official website
      देखें।
    </p>
  </div>
</section>
