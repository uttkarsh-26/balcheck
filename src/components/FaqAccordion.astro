---
/**
 * Single source for every FAQ accordion on the site.
 *
 * The audited defect: raw `details`/`summary` markup was duplicated on nine
 * templates and every summary measured 24px tall at 390px, well under the
 * 44px iOS HIG / WCAG 2.5.5 tap floor. Fixing it here means one summary
 * implementation, one 44px floor and one chevron - not nine call-site patches.
 *
 * Typography is fixed by the component (medium weight, 14px answers) so the
 * tap-target fix cannot drift per page; desktop sizes stay what the audited
 * pages already rendered.
 */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: readonly FaqItem[];
  /** List spacing; the site sections use `space-y-3`, tight cards `space-y-4`. */
  class?: string;
}

const { items, class: className = 'space-y-3' } = Astro.props;
---

<div class={className} data-testid="faq-accordion">
  {items.map((faq) => (
    <details class="group rounded-lg border border-gray-200 bg-white p-4">
      <summary
        class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-2 font-medium text-gray-900"
        data-testid="faq-summary"
      >
        {faq.q}
        <svg
          class="h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-gray-600">{faq.a}</p>
    </details>
  ))}
</div>
