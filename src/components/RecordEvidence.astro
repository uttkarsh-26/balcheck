---
/**
 * Visible citation for a published bank number: where the record came from and
 * the ISO date it was last checked.
 *
 * The audited defect: `/balance-enquiry/[slug]/`, `/aadhaar-link/[slug]/`,
 * `/mini-statement/` and `/number-lookup/` published numbers with no source and
 * no review date, even though every documented record in `src/data/banks.ts`
 * carries `verificationSource` and `lastVerified`.
 *
 * The block is only rendered when both fields exist (see
 * `hasDocumentedEvidence`), so an undocumented record shows nothing rather than
 * a placeholder, an approximate date or an invented source.
 */
import { ISO_DATE, evidenceSourceUrl } from '../lib/evidence';

interface Props {
  source?: string | null;
  lastVerified?: string | null;
  /** What the citation covers, e.g. `SBI balance enquiry record`. */
  scope?: string;
}

const { source, lastVerified, scope } = Astro.props;

const trimmedSource = typeof source === 'string' ? source.trim() : '';
const hasEvidence = Boolean(trimmedSource && lastVerified && ISO_DATE.test(lastVerified));
const sourceUrl = evidenceSourceUrl(trimmedSource);
---

{hasEvidence && (
  <section
    class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-5"
    data-testid="record-evidence"
  >
    <h2 class="mb-2 text-base font-bold text-amber-950">🔎 स्रोत और अंतिम सत्यापन</h2>
    <dl class="space-y-3 text-sm leading-relaxed text-amber-900">
      <div>
        <dt class="font-semibold">सत्यापन स्रोत{scope ? ` (${scope})` : ''}</dt>
        <dd class="mt-0.5 break-words" data-testid="record-evidence-source">
          {trimmedSource}
          {sourceUrl && (
            <>
              {' · '}
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold underline"
              >
                स्रोत लिंक खोलें
              </a>
            </>
          )}
        </dd>
      </div>
      <div>
        <dt class="font-semibold">अंतिम सत्यापन (last verified)</dt>
        <dd class="mt-0.5">
          <time datetime={lastVerified} class="font-semibold" data-testid="record-evidence-date">
            {lastVerified}
          </time>
          {' को इस record के numbers जांचे गए थे।'}
        </dd>
      </div>
    </dl>
    <p class="mt-3 text-xs leading-relaxed text-amber-900">
      Bank numbers और services बदल सकते हैं। Final confirmation के लिए बैंक की official website देखें।
    </p>
  </section>
)}
