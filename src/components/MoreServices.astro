---
import type { Bank } from '../data/banks';
import { isTrueTollFreeNumber } from '../lib/phone';
import Chip from './Chip.astro';

interface Props {
  bank: Bank;
}

const { bank } = Astro.props;
const services = [
  { href: 'balance-enquiry', icon: '💰', label: 'Balance Enquiry' },
  { href: 'mini-statement', icon: '🧾', label: 'Mini Statement' },
  { href: 'customer-care', icon: '🎧', label: 'Customer Care' },
  { href: 'net-banking', icon: '🌐', label: 'Net Banking' },
  { href: 'sms-banking', icon: '📱', label: 'SMS Banking' },
  { href: 'mobile-number-registration', icon: '📲', label: 'Mobile Registration' },
  { href: 'aadhaar-link', icon: '🪪', label: 'Aadhaar Link' },
  { href: 'atm-pin', icon: '🔐', label: 'ATM PIN' },
  // Conditional entries: only link a service the bank's data actually supports.
  // balanceMode drives the missed-call page (see src/pages/missed-call/[slug].astro);
  // banks whose balance number is their customer-care/IVR line get no such page.
  ...(bank.balanceMode === 'missed-call'
    ? [{ href: 'missed-call', icon: '📞', label: 'Missed Call Balance' }]
    : []),
  ...(isTrueTollFreeNumber(bank.customerCare)
    ? [{ href: 'toll-free-number', icon: '☎️', label: 'Toll-Free Customer Care' }]
    : []),
];
---

<section data-testid="more-services" class="mt-6 border-t border-gray-100 pt-6">
  <h2 class="text-h2 mb-3 font-bold text-gray-900">{bank.shortName} के लिए और सेवाएं</h2>
  {/* 8-10 chips: five per row (10 -> 2 full rows, 9 -> 5+4, 8 -> 5+3) never
      strands a lone chip the way the old 3-column grid did with 10. */}
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
    {services.map(service => (
      <Chip href={`/${service.href}/${bank.slug}/`} size="lg" class="border border-gray-200 bg-white px-3 py-2 text-brand-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
        <span aria-hidden="true">{service.icon}</span>
        <span class="min-w-0 break-words leading-normal" data-testid="more-services-label">{service.label}</span>
      </Chip>
    ))}
  </div>
</section>
