---
import type { Bank } from '../data/banks';
import { isTrueTollFreeNumber } from '../lib/phone';

interface Props {
  bank: Bank;
}

const { bank } = Astro.props;
const services = [
  { href: 'balance-enquiry', icon: '💰', label: 'Balance Enquiry' },
  { href: 'mini-statement', icon: '🧾', label: 'Mini Statement' },
  { href: 'customer-care', icon: '🎧', label: 'Customer Care' },
  { href: 'net-banking', icon: '🌐', label: 'Net Banking' },
  { href: 'sms-banking', icon: '📱', label: 'SMS Banking' },
  { href: 'mobile-number-registration', icon: '📲', label: 'Mobile Registration' },
  { href: 'aadhaar-link', icon: '🪪', label: 'Aadhaar Link' },
  { href: 'atm-pin', icon: '🔐', label: 'ATM PIN' },
  ...(isTrueTollFreeNumber(bank.customerCare)
    ? [{ href: 'toll-free-number', icon: '☎️', label: 'Toll-Free Customer Care' }]
    : []),
];
---
<section data-testid="more-services" class="mt-6 border-t border-gray-100 pt-6">
  <h2 class="mb-3 text-sm font-bold text-gray-900">{bank.shortName} के लिए और सेवाएं</h2>
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
    {services.map(service => (
      <a href={`/${service.href}/${bank.slug}/`} class="flex min-h-[52px] min-w-0 items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-medium text-brand-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
        <span aria-hidden="true">{service.icon}</span>
        <span class="min-w-0 break-words">{service.label}</span>
      </a>
    ))}
  </div>
</section>
