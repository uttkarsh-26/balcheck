---
import Layout from '../layouts/Layout.astro';
import { banks } from '../data/banks';

const siteUrl = 'https://balcheck.in';
const pageTitle = 'हमारे बारे में | BalCheck.in';
const pageDesc = `BalCheck.in क्या है — भारत के ${banks.length} बैंकों के balance enquiry methods की स्वतंत्र हिंदी directory। हम किसी बैंक या RBI से संबद्ध नहीं हैं।`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'About Us', item: `${siteUrl}/about/` },
  ],
};
---

<Layout title={pageTitle} description={pageDesc}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav class="max-w-3xl mx-auto px-4 pt-4" aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-sm text-gray-500">
    <li><a href="/" class="inline-block py-1.5 px-2 -ml-2 rounded-lg hover:text-brand-600 hover:bg-gray-100 transition-colors">होम</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li class="text-gray-900 font-medium py-1.5 px-1">हमारे बारे में</li>
  </ol>
</nav>

<main class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">BalCheck.in क्या है?</h1>
  <p class="mt-2 text-sm text-gray-600">बैंक बैलेंस जानने के सही नंबर — एक जगह, आसान हिंदी में।</p>

  <div class="mt-6 space-y-6 rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <section>
      <h2 class="text-lg font-bold text-gray-900">हम क्या करते हैं</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-700">BalCheck.in भारत के {banks.length} बैंकों के balance enquiry methods की स्वतंत्र directory है — missed-call नंबर, mini-statement नंबर, customer care, SMS banking और official net-banking links। लक्ष्य एक ही है: ग्रामीण और छोटे शहरों के users को सही नंबर जल्दी मिले, बिना भटकाव के।</p>
    </section>

    <section>
      <h2 class="text-lg font-bold text-gray-900">हम क्या नहीं हैं</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-700">हम <strong>किसी बैंक, RBI या सरकारी संस्था से संबद्ध नहीं हैं</strong>। यह कोई banking app नहीं है — यहां login नहीं होता, पैसे transfer नहीं होते, और हम आपका कोई खाता detail नहीं मांगते। असली लेन-देन हमेशा आपके बैंक के official channel से ही करें।</p>
    </section>

    <section>
      <h2 class="text-lg font-bold text-gray-900">नंबर कहां से आते हैं</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-700">सभी missed-call और helpline नंबर बैंकों की official वेबसाइटों और RBI की financial-education सामग्री से लिए गए हैं, और हर entry में source दर्ज है। फिर भी बैंक समय-समय पर नंबर बदलते हैं — कॉल करने से पहले बैंक की official साइट से पुष्टि कर लें। गलत नंबर दिखे तो <a class="text-brand-700 underline hover:text-brand-600" href="/contact/">हमें बताएं</a>, हम ठीक करेंगे।</p>
    </section>
  </div>
</main>
</Layout>
