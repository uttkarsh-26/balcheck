---
import Layout from '../layouts/Layout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { banks, categories, categoryHindi } from '../data/banks';

const bankCount = banks.length;
const publicCount = banks.filter(b => b.category === 'Public Sector').length;
const privateCount = banks.filter(b => b.category === 'Private Sector').length;
const sfbCount = banks.filter(b => b.category === 'Small Finance Bank').length;
const siteUrl = 'https://balcheck.in';
const bankingServices = [
  { href: '/balance-enquiry/', icon: '💰', title: 'Balance Enquiry', description: 'बैलेंस enquiry के सभी तरीके' },
  { href: '/mini-statement/', icon: '🧾', title: 'Mini Statement', description: 'आखिरी transactions की जानकारी' },
  { href: '/customer-care/', icon: '🎧', title: 'Customer Care', description: 'सभी बैंकों के customer care नंबर' },
  { href: '/net-banking/', icon: '🌐', title: 'Net Banking', description: 'Official online banking links' },
  { href: '/sms-banking/', icon: '📱', title: 'SMS Banking', description: 'SMS और balance methods' },
  { href: '/mobile-number-registration/', icon: '📲', title: 'Mobile Registration', description: 'खाते में मोबाइल नंबर जोड़ें' },
  { href: '/aadhaar-link/', icon: '🪪', title: 'Aadhaar Link', description: 'बैंक खाते से आधार लिंक करें' },
  { href: '/atm-pin/', icon: '🔐', title: 'ATM PIN', description: 'Debit card PIN बनाएं' },
  { href: '/toll-free-number/', icon: '☎️', title: '1800 Toll-Free Directory', description: '1800 numbers और correctly-labelled helplines' },
] as const;
const popularBanks = ['sbi', 'bob', 'canara', 'ubi', 'pnb', 'boi', 'indian-bank', 'hdfc', 'icici', 'axis']
  .map(slug => banks.find(bank => bank.slug === slug))
  .filter((bank): bank is (typeof banks)[number] => Boolean(bank));
---

<Layout
  title={`बैंक बैलेंस चेक नंबर — ${bankCount} बैंकों के Balance Enquiry Methods | BalCheck.in`}
  description={`भारत में ${bankCount} बैंकों के balance check numbers और enquiry methods: missed call, customer care/IVR, mini statement और official banking links एक जगह। अपना बैंक खोजें।`}
>
<SchemaOrg />

<!-- Demand-led hero: answer first, then search and directory -->
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-gray-100">
  <div class="mx-auto max-w-4xl px-4 py-8 text-center sm:py-10">
    <p class="mb-2 text-sm font-medium text-brand-700">Bank balance enquiry directory</p>
    <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-4xl">बैंक बैलेंस चेक नंबर</h1>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base">{bankCount} भारतीय बैंकों के balance check numbers और enquiry methods — missed call, customer care/IVR, mini statement और official banking links। अपना बैंक और सही तरीका चुनें।</p>
  </div>
</section>

<!-- Search + Bank Directory -->
<main class="max-w-6xl mx-auto px-4 py-8">
  <!-- Search -->
  <div class="relative mb-6">
    <input
      id="search"
      type="text"
      placeholder="बैंक का नाम खोजें... (जैसे SBI, HDFC, Canara)"
      class="w-full px-5 py-3.5 pl-12 text-base border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent shadow-sm"
      autocomplete="off"
    />
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
  </div>

  <!-- Popular bank shortcuts for high-demand queries -->
  <section id="popular-banks" class="mb-6 rounded-xl border border-brand-100 bg-brand-50/60 p-4">
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="text-base font-bold text-gray-900">Popular banks</h2>
      <a href="/banks/" class="shrink-0 text-xs font-medium text-brand-700 hover:underline">सभी categories →</a>
    </div>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
      {popularBanks.map(bank => (
        <a href={`/bank/${bank.slug}/`} class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-3 text-center text-sm font-medium text-gray-900 hover:border-brand-300 hover:text-brand-700">
          <span class="block truncate">{bank.shortName}</span>
          <span class="mt-1 block truncate text-[11px] text-gray-500">{bank.nameHindi}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Category Tabs -->
  <div id="categories" class="flex gap-2 overflow-x-auto pb-2 mb-6 -mx-4 px-4 scrollbar-hide">
    <button data-cat="all" class="cat-btn active px-4 py-2.5 text-sm font-medium rounded-full bg-brand-600 text-white whitespace-nowrap min-h-[44px]">
      सभी बैंक ({bankCount})
    </button>
    {categories.map(cat => (
      <button data-cat={cat} class="cat-btn px-4 py-2.5 text-sm font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 active:bg-gray-300 whitespace-nowrap transition-colors min-h-[44px]">
        {categoryHindi[cat]} ({banks.filter(b => b.category === cat).length})
      </button>
    ))}
  </div>

  <!-- Bank Cards Grid -->
  <div id="bank-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {banks.map(bank => (
      <div class="bank-card" data-name={`${bank.name} ${bank.nameHindi} ${bank.shortName}`.toLowerCase()} data-cat={bank.category}>
        <div class="bg-white rounded-xl border border-gray-200 p-4 hover:shadow-md hover:border-brand-300 transition-all duration-200">
          <!-- Bank Name -->
          <div class="flex items-start justify-between mb-3">
            <div>
              <a href={`/bank/${bank.slug}/`}>
                <h3 class="font-bold text-gray-900 text-base leading-tight hover:text-brand-600 transition-colors">{bank.nameHindi}</h3>
              </a>
              <p class="text-xs text-gray-500 mt-0.5">{bank.name}</p>
            </div>
            <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded shrink-0">
              {bank.shortName}
            </span>
          </div>

          <!-- Missed Call Number -->
          <a href={`tel:${bank.missedCall}`} class="block">
            <div class="bg-brand-50 rounded-lg p-3 mb-3 hover:bg-brand-100 transition-colors">
              <p class="text-xs text-brand-700 font-medium mb-1">📞 {bank.balanceMode === 'missed-call' ? 'मिस्ड कॉल नंबर' : 'Customer Care / IVR'}</p>
              <span class="text-xl font-bold text-brand-700 tracking-wide">{bank.missedCall}</span>
            </div>
          </a>

          <!-- Actions -->
          <div class="flex items-center gap-2">
            <a
              href={`tel:${bank.missedCall}`}
              class="flex-1 flex items-center justify-center gap-1.5 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white text-sm font-medium py-2.5 rounded-lg transition-colors min-h-[44px]"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              कॉल करें
            </a>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${bank.nameHindi} का बैलेंस enquiry नंबर: ${bank.missedCall}${bank.balanceMode === 'missed-call' ? ' (missed call)' : ' (customer care/IVR)'} — ${siteUrl}/bank/${bank.slug}/`)}`}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center w-11 h-11 bg-green-50 hover:bg-green-100 active:bg-green-200 text-green-600 rounded-lg transition-colors shrink-0"
              title="WhatsApp पर शेयर करें"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
          
          {bank.notes && (
            <p class="text-xs text-gray-400 mt-2">⚠️ {bank.notes}</p>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- No Results -->
  <div id="no-results" class="hidden py-12 text-center">
    <p class="text-lg text-gray-500">कोई बैंक नहीं मिला।</p>
    <p class="mt-1 text-sm text-gray-400">कृपया अलग नाम से खोजें।</p>
  </div>

  <!-- Category directory comes after the primary bank answer -->
  <section class="mt-10 border-t border-gray-100 pt-8">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 class="text-xl font-bold text-gray-900">Bank categories</h2>
      <a href="/banks/" class="text-sm font-medium text-brand-700 hover:underline">Open directory →</a>
    </div>
    <div class="flex flex-wrap gap-2">
      {categories.map(cat => (
        <a href={`/banks/${cat.toLowerCase().replace(/\s+/g, '-')}/`} class="inline-flex min-h-[44px] items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700">
          {categoryHindi[cat]} ({banks.filter(b => b.category === cat).length})
        </a>
      ))}
    </div>
  </section>

  <!-- Merged banks hub link (separate from the 9 service-grid cards) -->
  <section class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-4">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
      <div>
        <h2 class="text-sm font-bold text-amber-900">विलय हुई बैंकें — पुराने बैंक का नया नंबर</h2>
        <p class="text-xs text-amber-800 mt-0.5">RRB विलय (2019–2025) के बाद पुराने बैंक किस नए बैंक में गए और नया balance check number क्या है।</p>
      </div>
      <a href="/merged-banks/" class="shrink-0 inline-flex items-center justify-center min-h-[44px] rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 transition-colors">
        सूची देखें →
      </a>
    </div>
  </section>
</main>

<!-- Cheatsheet PDF CTA -->
<section class="bg-gradient-to-r from-brand-600 to-brand-800">
  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-6 text-center sm:text-left">
      <div class="text-5xl sm:text-6xl shrink-0">📄</div>
      <div class="flex-1">
        <h2 class="text-lg sm:text-xl font-bold text-white mb-1">सभी बैंक नंबर एक PDF में डाउनलोड करें</h2>
        <p class="text-sm text-brand-100">{bankCount} बैंकों के missed-call balance, mini statement और customer care नंबर — ऑफलाइन रखें, प्रिंट करें</p>
      </div>
      <a href="https://upseva.in/tools/bank-cheatsheet/" target="_blank" rel="noopener" class="shrink-0 inline-flex items-center gap-2 bg-white text-brand-700 font-bold text-sm px-6 py-3 rounded-xl hover:bg-brand-50 transition-colors shadow-lg whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        PDF डाउनलोड करें →
      </a>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="bg-white border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 text-center mb-6">कैसे काम करता है?</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-bold text-lg mx-auto mb-3">1</div>
        <h3 class="font-semibold text-gray-900 text-sm mb-1">Eligible service चुनें</h3>
        <p class="text-xs text-gray-500">Bank record में missed-call या customer-care/IVR label देखें</p>
      </div>
      <div class="text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-bold text-lg mx-auto mb-3">2</div>
        <h3 class="font-semibold text-gray-900 text-sm mb-1">Linked mobile इस्तेमाल करें</h3>
        <p class="text-xs text-gray-500">Missed-call service के लिए खाते से linked number जरूरी है</p>
      </div>
      <div class="text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-100 text-brand-600 font-bold text-lg mx-auto mb-3">3</div>
        <h3 class="font-semibold text-gray-900 text-sm mb-1">Bank instructions follow करें</h3>
        <p class="text-xs text-gray-500">Missed-call में SMS आएगा; IVR में menu और charges हो सकते हैं</p>
      </div>
    </div>
    <div class="text-center mt-6">
      <a href="/how-it-works/" class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:text-brand-700">
        पूरा गाइड पढ़ें →
      </a>
    </div>
  </div>
</section>

<!-- Banking Services Directory -->
<section class="bg-white border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 text-center mb-2">बैंकिंग सेवाएं</h2>
    <p class="text-sm text-gray-500 text-center mb-6">अपने बैंक की सभी सेवाएं एक जगह — {bankCount} बैंकों के लिए</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {bankingServices.map(service => (
        <a href={service.href} class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand-300 hover:shadow-sm transition-all text-center">
          <div class="text-3xl mb-2">{service.icon}</div>
          <h3 class="font-semibold text-gray-900 text-sm mb-1">{service.title}</h3>
          <p class="text-xs text-gray-500">{service.description}</p>
          <p class="text-xs text-brand-600 font-medium mt-2">{bankCount} बैंक →</p>
        </a>
      ))}
      <a href="https://upseva.in/tools/bank-cheatsheet/" target="_blank" rel="noopener" class="bg-gradient-to-br from-brand-50 to-purple-50 rounded-xl border-2 border-brand-200 p-5 hover:border-brand-400 hover:shadow-md transition-all text-center">
        <div class="text-3xl mb-2">📄</div>
        <h3 class="font-semibold text-gray-900 text-sm mb-1">Cheatsheet PDF</h3>
        <p class="text-xs text-gray-500">सभी नंबर एक PDF में</p>
        <p class="text-xs text-brand-600 font-medium mt-2">डाउनलोड →</p>
      </a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="bg-gray-50 border-t border-gray-100">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 text-center mb-6">अक्सर पूछे जाने वाले प्रश्न</h2>
    <div class="space-y-3">
      <details class="bg-white rounded-lg border border-gray-200 p-4 group">
        <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center">
          मिस्ड कॉल से बैलेंस कैसे पता करें?
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600">अपने बैंक के record में registered mobile से उपलब्ध balance-enquiry number पर कॉल करें। यदि वह missed-call service है तो कॉल अपने आप कट सकती है; customer-care/IVR numbers पर सामान्य call charges या menu लागू हो सकते हैं।</p>
      </details>
      <details class="bg-white rounded-lg border border-gray-200 p-4 group">
        <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center">
          क्या balance enquiry पर charge लगता है?
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600">Missed-call services आम तौर पर charge-free होती हैं, लेकिन हर bank और customer-care/IVR channel की शर्तें अलग हो सकती हैं। अपने bank की official instructions और telecom plan की जानकारी देखें।</p>
      </details>
      <details class="bg-white rounded-lg border border-gray-200 p-4 group">
        <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center">
          मेरा नंबर बैंक में रजिस्टर्ड नहीं है तो?
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600">अगर आपका मोबाइल नंबर बैंक खाते से लिंक नहीं है, तो missed call सेवा काम नहीं करेगी। अपनी बैंक शाखा में जाकर या ATM से मोबाइल नंबर रजिस्टर करवाएं। इसके बाद missed call सेवा उपलब्ध हो जाएगी।</p>
      </details>
      <details class="bg-white rounded-lg border border-gray-200 p-4 group">
        <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center">
          SMS नहीं आया तो क्या करें?
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600">अगर SMS नहीं आता, तो जांचें: (1) आपका नंबर बैंक में रजिस्टर्ड है या नहीं, (2) DND सेवा तो चालू नहीं है, (3) आप सही नंबर पर कॉल कर रहे हैं। फिर भी समस्या हो तो बैंक के customer care से संपर्क करें।</p>
      </details>
      <details class="bg-white rounded-lg border border-gray-200 p-4 group">
        <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center">
          क्या ये नंबर सुरक्षित हैं?
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600">नंबर bank websites और cross-check sources से संकलित किए जाते हैं, लेकिन वे बदल सकते हैं। इस्तेमाल से पहले official bank website पर current number verify करें और किसी call पर OTP, PIN, CVV या password साझा न करें।</p>
      </details>
    </div>
  </div>
</section>

<!-- Footer -->
