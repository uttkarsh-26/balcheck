---
import Layout from '../../layouts/Layout.astro';
import { mergers } from '../../data/mergers';
import { banks } from '../../data/banks';

export function getStaticPaths() {
  return mergers.map((m) => ({
    params: { oldSlug: m.oldSlug },
    props: { merger: m },
  }));
}

interface Props {
  merger: (typeof mergers)[number];
}

const { merger } = Astro.props;
const successor = banks.find((b) => b.slug === merger.successorSlug)!;
const firstEvent = merger.events[0];

const siteUrl = 'https://balcheck.in';
const canonicalUrl = `${siteUrl}/merged-banks/${merger.oldSlug}/`;
const isMissedCall = successor.balanceMode === 'missed-call';
const serviceLabel = isMissedCall ? 'missed-call balance enquiry number' : 'balance enquiry / customer care number';

const pageTitle = `${merger.oldName} Balance Check Number | ${successor.shortName}`;
const pageDesc = `${merger.oldName}: ${firstEvent.effectiveDate} merger; current successor ${successor.shortName}. Balance check number ${successor.missedCall}. Official timeline और sources देखें।`;

const faqs = [
  {
    q: `${merger.oldNameHindi} का विलय किस बैंक में हुआ?`,
    a: `${merger.oldNameHindi} का पहला विलय ${firstEvent.effectiveDate} को ${firstEvent.resultingName} में हुआ। आधिकारिक lineage के अनुसार वर्तमान successor ${successor.name} है।`,
  },
  {
    q: `${merger.oldName} के पुराने खाते का क्या हुआ?`,
    a: `विलय के बाद खाते की वर्तमान स्थिति, branch mapping या service migration की पुष्टि ${successor.name} से करें। मौजूदा customer care ${successor.customerCare} है।`,
  },
  {
    q: `${merger.oldNameHindi} का नया balance check number क्या है?`,
    a: `${merger.oldNameHindi} के खाते अब ${successor.name} में हैं, इसलिए balance check के लिए ${successor.name} का नंबर ${successor.missedCall} इस्तेमाल करें — यही ${serviceLabel} है।`,
  },
  {
    q: `क्या पुराने ${merger.oldName} missed-call नंबर अब भी चलते हैं?`,
    a: `पुराने नंबर की उपलब्धता पर निर्भर न रहें। Balance enquiry के लिए ${successor.name} का वर्तमान verified number ${successor.missedCall} इस्तेमाल करें।`,
  },
];

// Old entity schema — dissolutionDate from the official timeline, no telephone
// (the old bank no longer exists; the successor's number comes from banks.ts).
const bankSchema = {
  '@context': 'https://schema.org',
  '@type': 'BankOrCreditUnion',
  name: merger.oldName,
  alternateName: merger.oldNameHindi,
  description: `${merger.oldName} का ${firstEvent.effectiveDate} को ${firstEvent.resultingName} में विलय हुआ; वर्तमान successor ${successor.name} है।`,
  url: canonicalUrl,
  dissolutionDate: firstEvent.effectiveDate,
  areaServed: { '@type': 'Country', name: 'India' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'विलय हुई बैंकें', item: `${siteUrl}/merged-banks/` },
    { '@type': 'ListItem', position: 3, name: merger.oldNameHindi, item: canonicalUrl },
  ],
};

// Format ISO date to Hindi-style display date (keeps the ISO visible for tests)
const displayDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d}.${m}.${y}`;
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
<script type="application/ld+json" set:html={JSON.stringify(bankSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- Breadcrumb -->
<nav class="max-w-4xl mx-auto px-4 pt-4" aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-sm text-gray-500 flex-wrap">
    <li><a href="/" class="inline-block py-1.5 px-2 -ml-2 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">होम</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li><a href="/merged-banks/" class="inline-block py-1.5 px-1 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">विलय हुई बैंकें</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li class="text-gray-900 font-medium py-1.5 px-1">{merger.oldNameHindi}</li>
  </ol>
</nav>

<!-- Header -->
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">{merger.oldNameHindi} बैलेंस चेक नंबर — {successor.nameHindi} में विलय</h1>
    <p class="text-sm text-gray-500 mt-1">{merger.oldName} · {displayDate(firstEvent.effectiveDate)} से {firstEvent.resultingName}; अब {successor.name}</p>
  </div>
</section>

<main class="max-w-4xl mx-auto px-4 py-6">
  <!-- Merger notice with official citation -->
  <div data-testid="merger-notice" class="bg-amber-50 rounded-xl border-2 border-amber-200 p-5">
    <p class="text-sm sm:text-base text-amber-900 font-medium">
      ⚠️ {merger.oldNameHindi} अब अलग बैंक के रूप में मौजूद नहीं है — {displayDate(firstEvent.effectiveDate)} को {firstEvent.resultingNameHindi} में विलय हुआ। वर्तमान successor {successor.nameHindi} है।
    </p>
    <p class="text-xs text-amber-800 mt-2 leading-relaxed">
      {merger.noteHindi}
    </p>
    <p class="text-xs text-amber-800 mt-2">
      स्रोत:
      {merger.events.map((event, index) => (
        <span>
          {index > 0 && ' · '}
          <a href={event.sourceUrl} target="_blank" rel="noopener" class="font-semibold underline">{event.sourceLabel}</a>
        </span>
      ))}
    </p>
  </div>

  <!-- Current successor number — the ONLY number on this page -->
  <div data-testid="successor-balance-service" class="mt-5 bg-white rounded-2xl border-2 border-brand-200 p-5 shadow-sm">
    <p class="text-sm text-brand-700 font-medium mb-1">📞 अब का balance check number ({successor.nameHindi})</p>
    <a href={`tel:${successor.missedCall}`} class="block">
      <span class="text-3xl sm:text-4xl font-bold text-brand-700 tracking-wide">{successor.missedCall}</span>
    </a>
    <p class="text-xs text-gray-500 mt-1">{serviceLabel} — {isMissedCall ? 'रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में बैलेंस मिलेगा' : 'कॉल करके balance enquiry विकल्प चुनें'}</p>
    <a
      href={`tel:${successor.missedCall}`}
      class="mt-4 w-full flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-medium py-3.5 rounded-xl transition-colors text-base min-h-[48px]"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      अभी कॉल करें
    </a>
    <a href={`/bank/${successor.slug}/`} class="mt-3 inline-block text-sm font-medium text-brand-600 hover:text-brand-700">
      {successor.nameHindi} की पूरी जानकारी देखें →
    </a>
  </div>

  <!-- Official merger timeline -->
  <section class="mt-6 bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">आधिकारिक विलय timeline</h2>
    <div class="space-y-4">
      {merger.events.map(event => (
        <div class="border-l-2 border-brand-200 pl-4">
          <p class="text-sm font-bold text-gray-900">{event.effectiveDate} ({displayDate(event.effectiveDate)}) — {event.resultingNameHindi}</p>
          <p class="text-xs text-gray-500 mt-0.5">{event.resultingName}</p>
          <p class="text-xs text-gray-600 mt-1 leading-relaxed">{merger.noteHindi}</p>
          <a href={event.sourceUrl} target="_blank" rel="noopener" class="inline-block mt-2 text-xs font-medium text-brand-600 hover:underline">
            स्रोत: {event.sourceLabel} ↗
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="mt-6 bg-gray-50 rounded-xl border border-gray-100 p-5">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">❓ अक्सर पूछे जाने वाले प्रश्न</h2>
    <div class="space-y-4">
      {faqs.map(faq => (
        <details class="bg-white rounded-lg border border-gray-200 p-4 group">
          <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center gap-2 text-sm">
            {faq.q}
            <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Hub + disclaimer -->
  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
    <a href="/merged-banks/" class="bg-white rounded-xl border border-gray-200 p-4 text-center hover:border-brand-300 transition-colors">
      <p class="text-xs text-gray-500 mb-1">🏦 विलय हुई बैंकें</p>
      <p class="text-sm font-medium text-brand-700">सभी विलय की सूची देखें →</p>
    </a>
    <a href="/banks/regional-rural-bank/" class="bg-white rounded-xl border border-gray-200 p-4 text-center hover:border-brand-300 transition-colors">
      <p class="text-xs text-gray-500 mb-1">🌾 क्षेत्रीय ग्रामीण बैंक</p>
      <p class="text-sm font-medium text-brand-700">मौजूदा RRB नंबर →</p>
    </a>
  </div>

  <div class="mt-6 bg-gray-50 rounded-xl border border-gray-200 p-4">
    <p class="text-xs text-gray-500 leading-relaxed">
      BalCheck.in बैंक नहीं है। विलय की तारीखें और नाम भारत सरकार के राजपत्र / RBI / DICGC / बैंक की आधिकारिक वेबसाइट से लिए गए हैं; ऊपर हर चरण का स्रोत लिंक दिया गया है। Balance check के लिए हमेशा {successor.name} का मौजूदा नंबर ही use करें।
    </p>
  </div>
</main>
</Layout>
