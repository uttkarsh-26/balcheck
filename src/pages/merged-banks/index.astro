---
import Layout from '../../layouts/Layout.astro';
import { mergers } from '../../data/mergers';
import { banks } from '../../data/banks';

const siteUrl = 'https://balcheck.in';
const canonicalUrl = `${siteUrl}/merged-banks/`;

const withBank = mergers.map((m) => ({
  ...m,
  successor: banks.find((b) => b.slug === m.successorSlug)!,
  firstEvent: m.events[0],
}));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'विलय हुई बैंकें — पुराने बैंक का नया balance check number',
  description: `अभी शामिल ${mergers.length} विलय हुई ग्रामीण बैंकों की सूची — कौन सा पुराना बैंक किस नए बैंक में विलय हुआ, कब हुआ, और अब balance check का नया नंबर क्या है।`,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: mergers.length,
    itemListElement: withBank.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/merged-banks/${m.oldSlug}/`,
      name: m.oldName,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'विलय हुई बैंकें', item: canonicalUrl },
  ],
};

const pageTitle = 'विलय हुई बैंकें — पुराने बैंक का नया balance check number | BalCheck.in';
const pageDesc = `${mergers.length} ग्रामीण बैंक विलय की पूरी सूची: पुराना बैंक → नया बैंक, विलय की तारीख और अब का balance check number। RRB विलय 2019, 2020 और 2025।`;
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

<!-- Breadcrumb -->
<nav class="max-w-4xl mx-auto px-4 pt-4" aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-sm text-gray-500 flex-wrap">
    <li><a href="/" class="inline-block py-1.5 px-2 -ml-2 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">होम</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li class="text-gray-900 font-medium py-1.5 px-1">विलय हुई बैंकें</li>
  </ol>
</nav>

<!-- Header -->
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">विलय हुई बैंकें — पुराने बैंक का नया balance check number</h1>
    <p class="mt-2 text-gray-600">
      ये ग्रामीण बैंक (RRB) अब मौजूद नहीं हैं — विलय के बाद अब किस बैंक में गए, कब गए और नया balance check number क्या है, यहाँ देखें। अभी शामिल {mergers.length} बैंकों की सूची।
    </p>
  </div>
</section>

<main class="max-w-4xl mx-auto px-4 py-8">
  <div class="space-y-4">
    {withBank.map(m => (
      <div data-old-slug={m.oldSlug} class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand-300 hover:shadow-sm transition-all">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <a href={`/merged-banks/${m.oldSlug}/`} class="font-bold text-gray-900 hover:text-brand-600 transition-colors">
              {m.oldNameHindi}
            </a>
            <p class="text-xs text-gray-500 mt-0.5">{m.oldName}</p>
          </div>
          <span class="text-xs font-medium text-amber-700 bg-amber-50 px-3 py-1.5 rounded-full shrink-0">
            {m.firstEvent.effectiveDate} से विलय
          </span>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          <span class="text-gray-500">अब:</span>
          <a href={`/bank/${m.successor.slug}/`} class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-800">
            {m.successor.nameHindi}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href={`tel:${m.successor.missedCall}`} class="font-bold text-gray-900 hover:text-brand-700">{m.successor.missedCall}</a>
        </div>
        <div class="mt-2 text-xs text-gray-400">
          {m.events.length > 1 ? `${m.events.length} चरणों में विलय` : 'एक ही चरण में विलय'} —{' '}
          <a href={`/merged-banks/${m.oldSlug}/`} class="text-brand-600 font-medium hover:underline">पूरी timeline देखें →</a>
        </div>
      </div>
    ))}
  </div>

  <!-- Note -->
  <div class="mt-8 bg-amber-50 rounded-xl border border-amber-200 p-4">
    <p class="text-sm text-amber-800 leading-relaxed">
      ⚠️ पुराने बैंक के नंबर की उपलब्धता पर निर्भर न रहें। Balance enquiry के लिए ऊपर दिया गया वर्तमान successor-bank नंबर इस्तेमाल करें और account/branch migration की पुष्टि successor bank से करें।
    </p>
  </div>

  <div class="mt-6 bg-gray-50 rounded-xl border border-gray-200 p-4">
    <p class="text-xs text-gray-500 leading-relaxed">
      BalCheck.in बैंक नहीं है। हर विलय की जानकारी भारत सरकार के राजपत्र, RBI अधिसूचना या बैंक की आधिकारिक वेबसाइट से ली गई है — हर पेज पर स्रोत का लिंक दिया गया है।
    </p>
  </div>
</main>
</Layout>
