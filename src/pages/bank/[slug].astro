---
import Layout from '../../layouts/Layout.astro';
import { banks, categories, categoryHindi } from '../../data/banks';
import type { Bank } from '../../data/banks';
import { getMerger, getPredecessors } from '../../data/mergers';
import VideoHeroBanner from '../../components/VideoHeroBanner.astro';

export function getStaticPaths() {
  return banks.map(bank => ({
    params: { slug: bank.slug },
    props: { bank },
  }));
}

interface Props { bank: Bank }
const { bank } = Astro.props;
const isMissedCall = bank.balanceMode === 'missed-call';
const serviceLabel = isMissedCall ? 'मिस्ड कॉल बैलेंस नंबर' : 'Customer Care / Balance Enquiry';
const serviceInstruction = isMissedCall
  ? 'रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं।'
  : 'इस customer-care/IVR नंबर पर कॉल करके balance enquiry विकल्प चुनें।';

const siteUrl = 'https://balcheck.in';
const canonicalUrl = `${siteUrl}/bank/${bank.slug}/`;

// Merger record for this bank (only old pre-merger slugs have one)
const merger = getMerger(bank.slug);
const firstEvent = merger?.events[0];
const finalEvent = merger?.events[merger.events.length - 1];
// Reverse direction: banks that merged INTO this bank (successor pages only)
const predecessors = getPredecessors(bank.slug);

// Related banks (same category, max 4)
const related = banks
  .filter(b => b.category === bank.category && b.slug !== bank.slug)
  .slice(0, 4);

// Category slug
const catSlug = bank.category.toLowerCase().replace(/\s+/g, '-');

// FAQ items
const faqs = [
  {
    q: `${bank.shortName} का बैलेंस चेक करने का नंबर क्या है?`,
    a: `${bank.name} (${bank.shortName}) का balance enquiry number ${bank.missedCall} है। ${serviceInstruction}`
  },
  {
    q: `${bank.nameHindi} से बैलेंस कैसे चेक करें?`,
    a: `${bank.nameHindi} खाते का बैलेंस जानने के लिए ${bank.missedCall} पर कॉल करें। ${serviceInstruction}`
  },
  {
    q: `क्या ${bank.shortName} balance enquiry सेवा मुफ़्त है?`,
    a: isMissedCall ? `हाँ, ${bank.name} की verified missed-call balance enquiry सेवा मुफ़्त है।` : `यह customer-care/IVR line है; telecom या bank के सामान्य call charges लागू हो सकते हैं।`
  },
  {
    q: `${bank.shortName} का customer care नंबर क्या है?`,
    a: `${bank.name} का customer care नंबर ${bank.customerCare} है। बैंकिंग सहायता और balance enquiry के लिए इस नंबर पर संपर्क करें।`
  },
];

if (bank.notes) {
  faqs.push({
    q: `${bank.shortName} balance enquiry के बारे में ज़रूरी जानकारी`,
    a: bank.notes,
  });
}

// WhatsApp-banking answer — rendered ONLY for banks whose official site was
// actually checked (bank.whatsappBanking set). Never derived from aggregators;
// the section states what the official site offers instead of inventing a
// number for a channel the bank does not publish.
const waCheck = bank.whatsappBanking;
const waFaqs = waCheck ? [
  {
    q: `${bank.shortName} का WhatsApp बैंकिंग नंबर क्या है?`,
    a: `${bank.name} की आधिकारिक वेबसाइट ${waCheck.sourceUrl.replace('https://', '')} पर WhatsApp बैंकिंग का कोई नंबर नहीं दिया गया है (${waCheck.checkedOn} को जांचा गया)। बैलेंस जानने के लिए ${bank.missedCall} पर मिस्ड कॉल दें या ${bank.customerCare} पर customer care से बात करें। किसी भी तीसरे वेबसाइट पर दिया गया "WhatsApp नंबर" आधिकारिक नहीं है — उस पर अपनी जानकारी या पैसे का जोखिम न लें।`,
  },
] : [];
if (waFaqs.length > 0) {
  faqs.push(...waFaqs);
}

// PSB full-name cluster: GSC shows 'punjab and sind bank balance check number',
// 'psb balance check number' and 'punjab and sind' spellings as the top demand.
// Make the H1 own both spellings and add full-name FAQs.
const psbH1 = 'Punjab & Sind Bank (PSB) बैलेंस चेक नंबर';
if (bank.slug === 'psb') {
  faqs.push(
    {
      q: 'Punjab and Sind Bank का balance check number क्या है?',
      a: `Punjab & Sind Bank, जिसे PSB के नाम से भी जाना जाता है, का balance check number ${bank.missedCall} है। अपने registered mobile नंबर से मिस्ड कॉल दें — कॉल 2-3 ring के बाद अपने आप कट जाएगी और SMS में तुरंत बैलेंस आ जाएगा।`,
    },
    {
      q: 'PSB किस बैंक का छोटा नाम है — पूरा नाम क्या है?',
      a: `PSB का पूरा नाम Punjab & Sind Bank है — हिंदी में पंजाब एंड सिंध बैंक। यह भारत का सरकारी (public sector) बैंक है जिसकी स्थापना 1908 में हुई थी। इस पेज पर PSB/Punjab & Sind Bank के balance check, missed call और customer care नंबर दिए गए हैं।`,
    },
    {
      q: 'Punjab & Sind Bank balance enquiry मुफ़्त है या charge लगता है?',
      a: `${bank.name} की missed-call balance enquiry सेवा अधिकांश ऑपरेटरों पर मुफ़्त है क्योंकि कॉल जवाब में जुड़ती नहीं। बैंक की नवीनतम शर्तें आधिकारिक वेबसाइट ${bank.website.replace('https://', '')} पर देखें।`,
    },
  );
}

// JSON-LD: BankOrCreditUnion + FAQPage + BreadcrumbList + HowTo
const bankSchema = {
  '@context': 'https://schema.org',
  '@type': 'BankOrCreditUnion',
  name: bank.name,
  alternateName: bank.slug === 'psb'
    ? [bank.shortName, 'Punjab and Sind Bank', 'पंजाब एंड सिंध बैंक']
    : bank.shortName,
  description: `${bank.name} balance enquiry number ${bank.missedCall}. ${serviceInstruction}`,
  url: canonicalUrl,
  telephone: bank.missedCall,
  areaServed: { '@type': 'Country', name: 'India' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${bank.nameHindi} से बैलेंस कैसे चेक करें`,
  step: isMissedCall ? [
    { '@type': 'HowToStep', text: `${bank.missedCall} पर अपने रजिस्टर्ड मोबाइल से कॉल करें` },
    { '@type': 'HowToStep', text: '2-3 ring के बाद कॉल अपने आप कट जाएगी' },
    { '@type': 'HowToStep', text: 'कुछ सेकंड में SMS में बैलेंस प्राप्त करें' },
  ] : [
    { '@type': 'HowToStep', text: `${bank.customerCare} Customer Care / IVR पर कॉल करें` },
    { '@type': 'HowToStep', text: 'Balance enquiry विकल्प चुनें' },
    { '@type': 'HowToStep', text: 'Bank के निर्देशों के अनुसार verification पूरा करें' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: categoryHindi[bank.category], item: `${siteUrl}/banks/${catSlug}/` },
    { '@type': 'ListItem', position: 3, name: bank.nameHindi, item: canonicalUrl },
  ],
};

// GSC-driven overrides for high-impression pages. Keep the default scalable,
// but match the exact language people use for the banks with the most demand.
const seoOverrides: Partial<Record<string, { title: string; description?: string }>> = {
  boi: {
    title: `BOI बैलेंस चेक नंबर ${bank.missedCall} | Missed Call`,
    description: `बैंक ऑफ इंडिया (BOI) बैलेंस चेक नंबर: ${bank.missedCall}। आधिकारिक मिस्ड कॉल सेवा — SMS में तुरंत बैलेंस पाएं। मिनी स्टेटमेंट: ${bank.missedCallAlt}। मुफ़्त, 24×7।`,
  },
  // 4,568 impressions: 93% Latin queries @ 0.77% CTR vs 6% Devanagari @ 2.69%.
  // The Devanagari-first title never bold-matched 'bandhan bank balance enquiry
  // number' (985 impressions @ 1 click). Latin query phrase leads; the Hindi
  // brand name stays in the H1 and body.
  bandhan: {
    title: `Bandhan Bank Balance Check Number ${bank.missedCall} | Missed Call`,
    description: `Bandhan Bank balance check number ${bank.missedCall} — आधिकारिक मिस्ड कॉल सेवा। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत खाता बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  sbi: {
    title: `SBI बैलेंस चेक नंबर ${bank.missedCall} | मिस्ड कॉल सेवा`,
    description: `भारतीय स्टेट बैंक (SBI) का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं।`,
  },
  'baroda-up-gramin': {
    title: `Baroda UP Gramin Bank Balance Check Number ${bank.missedCall}`,
    description: `बड़ौदा यूपी ग्रामीण बैंक का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  'idfc-first': {
    title: `IDFC FIRST बैलेंस चेक नंबर ${bank.missedCall} | Missed Call`,
    description: `आईडीएफसी फर्स्ट बैंक का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  kvb: {
    title: `KVB बैलेंस चेक नंबर ${bank.missedCall} | Karur Vysya Missed Call`,
    description: `करूर वैश्य बैंक (KVB) का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  cosmos: {
    title: `Cosmos Bank Balance Check Number ${bank.missedCall}`,
    description: `Cosmos Bank balance check number: ${bank.missedCall}. आधिकारिक missed call सेवा — registered mobile से call करें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  maharashtra: {
    title: `Bank of Maharashtra Balance Check Number ${bank.missedCall}`,
    description: `Bank of Maharashtra balance check number: ${bank.missedCall}. आधिकारिक missed call सेवा — registered mobile से call करें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  icici: {
    title: `ICICI Bank Balance Check Number ${bank.missedCall}`,
    description: `ICICI Bank balance check number: ${bank.missedCall}. आधिकारिक missed call सेवा — registered mobile से call करें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  axis: {
    title: `Axis Bank Balance Enquiry Number ${bank.missedCall} | Missed Call`,
    description: `Axis Bank balance enquiry number: ${bank.missedCall}. आधिकारिक missed call सेवा — registered mobile से call करें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  iob: {
    title: `Indian Overseas Bank Balance Check Number ${bank.missedCall}`,
    description: `IOB balance check number ${bank.missedCall}. आधिकारिक missed call service: registered mobile से call करें, SMS में तुरंत बैलेंस पाएं। मुफ़्त 24×7।`,
  },
  // 2,705 impressions/30d on 'uttar pradesh gramin bank balance enquiry
  // whatsapp number' variants (plus 148 on the MP variant) at pos 8.3 with ~0
  // clicks — the snippet promised a number but the page never answered the
  // WhatsApp intent. Title now names the WhatsApp reality and keeps the
  // missed-call number; description carries the checked date.
  'up-gramin': {
    title: `Uttar Pradesh Gramin Bank WhatsApp Number नहीं | ${bank.missedCall}`,
    description: `UPGB की आधिकारिक वेबसाइट पर WhatsApp बैंकिंग नहीं है (18-09-2026 जांचा)। बैलेंस के लिए ${bank.missedCall} पर मिस्ड कॉल दें — SMS में तुरंत बैलेंस।`,
  },
  // 25,424 impressions, 93% Latin queries @ 0.07% CTR — the worst CTR of any
  // page with volume on the site — while the 6% Devanagari impressions convert
  // at 1.11%. Top queries use the FULL name ('punjab and sind bank balance
  // check number' 4,430 @ 0.05%, 'punjab sind bank...' 1,029 @ 0%), but the
  // title led with the 'PSB' abbreviation and buried the brand after the
  // number. Full name first, abbreviation as the tail token.
  psb: {
    title: `Punjab & Sind Bank Balance Check Number ${bank.missedCall} | PSB`,
    description: `Punjab & Sind Bank (PSB) का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। Registered mobile से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  // 1,582 impressions, 85% Latin queries @ 0.07% CTR ('hdfc balance check
  // number' 578 @ pos 6.0, 'hdfc bank balance check number' 208) while the
  // 13% Devanagari impressions get 0%. Devanagari-first default title never
  // matched the Latin query; Latin phrase leads, number and hook kept.
  hdfc: {
    title: `HDFC Bank Balance Check Number ${bank.missedCall} | Missed Call`,
    description: `HDFC Bank balance check number ${bank.missedCall} — आधिकारिक मिस्ड कॉल सेवा। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  // 2,563 impressions, 68% Latin queries @ 0.40% CTR vs 27% Devanagari @ 0.14%;
  // top query 'uco bank balance enquiry number mini statement' (592 @ 3 clicks,
  // pos 7.2) is Latin while the default template led with 'यूको बैंक'.
  'uco-bank': {
    title: `UCO Bank Balance Check Number ${bank.missedCall} | Missed Call`,
    description: `UCO Bank balance check number ${bank.missedCall} — आधिकारिक मिस्ड कॉल सेवा। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  'central-bank': {
    title: `सेंट्रल बैंक बैलेंस चेक नंबर ${bank.missedCall} | Missed Call`,
  },
  'mp-gramin': {
    title: `MPGB Balance Check Number ${bank.missedCall} | Missed Call`,
  },
  'indian-bank': {
    title: `Indian Bank Balance Check Number ${bank.missedCall}`,
  },
  // 2026-08-14..09-12 window: 12,206 impr @ pos 7.4 (0.11% CTR), dominant
  // query 'केनरा बैंक बैलेंस चेक नंबर' — the template title already carries the
  // exact Hindi phrase; this locks it and trades the Latin brand tail for the
  // Hindi "मिस्ड कॉल सेवा" hook users see in the SERP.
  canara: {
    title: `केनरा बैंक बैलेंस चेक नंबर ${bank.missedCall} | मिस्ड कॉल सेवा`,
    description: `केनरा बैंक बैलेंस चेक नंबर ${bank.missedCall}। आधिकारिक मिस्ड कॉल सेवा — रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
  // 4,332 impr @ pos 8.6 (0.30%) + 1,457 @ 8.2 on 'indusind bank balance
  // check number' / 'balance enquiry number'. The 1800 number is a verified
  // toll-free customer-care/IVR line (balanceMode 'customer-care'), so the
  // title keeps the exact English query and adds the toll-free hook instead
  // of claiming a missed-call facility.
  indusind: {
    title: `IndusInd Bank Balance Check Number ${bank.missedCall} — Toll Free`,
    description: `IndusInd Bank balance check number ${bank.missedCall} — आधिकारिक टोल-फ्री customer care/IVR नंबर। कॉल करके balance enquiry करें, तुरंत जानकारी पाएं। मुफ़्त, 24×7।`,
  },
  // 3,366 impr @ pos 7.0 (0.59% CTR) on 'bihar gramin bank balance check
  // number'. Title already matches the query exactly; the CTR gap comes from
  // the old customer-care description that told users the service was
  // "verified नहीं". Same toll-free line, now described as the official one.
  'bihar-gramin': {
    title: `Bihar Gramin Bank Balance Check Number ${bank.missedCall}`,
    description: `Bihar Gramin Bank balance check number ${bank.missedCall} — आधिकारिक टोल-फ्री नंबर। कॉल करके बैलेंस enquiry करें, तुरंत जानकारी पाएं। मुफ़्त, 24×7।`,
  },
  // 2,767 impr @ pos 6.0 (0.58% CTR) on 'punjab gramin bank balance check
  // number'; /sms-banking/punjab-gramin/ (2,558 @ 6.5) has its own title map.
  // Truthfulness: pgb.bank.in is bot-blocked (468) and 18001807777 is confirmed
  // by aggregators only — the snippet must NOT claim आधिकारिक (official).
  'punjab-gramin': {
    title: `Punjab Gramin Bank Balance Check Number ${bank.missedCall}`,
    description: `Punjab Gramin Bank balance check number ${bank.missedCall} — टोल-फ्री नंबर पर कॉल करके बैलेंस enquiry करें, तुरंत जानकारी पाएं। मुफ़्त, 24×7।`,
  },
  // 1,461 impr @ pos 8.9 (0.27% CTR) on 'idbi bank balance check number' —
  // English query, so the title switches from the Hindi default template to
  // the exact English phrase the demand uses.
  idbi: {
    title: `IDBI Bank Balance Check Number ${bank.missedCall} | Missed Call`,
    description: `IDBI Bank balance check number ${bank.missedCall} — आधिकारिक मिस्ड कॉल सेवा। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`,
  },
};

const customerCareTitle = `${bank.name} Balance Check Number ${bank.missedCall}`;
const conciseCustomerCareTitle = customerCareTitle.length <= 60
  ? customerCareTitle
  : `${bank.shortName} Balance Check Number ${bank.missedCall}`;
const defaultMissedCallTitle = `${bank.nameHindi} बैलेंस चेक नंबर ${bank.missedCall} | ${bank.shortName} Missed Call`;
const conciseMissedCallTitle = `${bank.nameHindi} बैलेंस चेक नंबर ${bank.missedCall}`;
const compactMissedCallTitle = `${bank.shortName} Balance Check Number ${bank.missedCall}`;
const requestedMissedCallTitle = seoOverrides[bank.slug]?.title ?? defaultMissedCallTitle;
// Overrides apply on both branches: customer-care/IVR pages (same number for
// balance enquiry and customer care) must not advertise a missed-call facility,
// but they still need a demand-matched snippet. Only pages with an explicit
// override are affected.
const pageTitle = !isMissedCall
  ? (seoOverrides[bank.slug]?.title ?? conciseCustomerCareTitle)
  : requestedMissedCallTitle.length <= 60
    ? requestedMissedCallTitle
    : conciseMissedCallTitle.length <= 60
      ? conciseMissedCallTitle
      : compactMissedCallTitle;
const defaultMissedCallDesc = `${bank.nameHindi} (${bank.shortName}) का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall} है। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें, SMS में तुरंत बैलेंस पाएं। मुफ़्त, 24×7।`;
const compactMissedCallDesc = `${bank.nameHindi} का आधिकारिक बैलेंस चेक नंबर ${bank.missedCall}। रजिस्टर्ड मोबाइल से मिस्ड कॉल दें; SMS में तुरंत बैलेंस पाएं। मुफ़्त 24×7।`;
const requestedMissedCallDesc = seoOverrides[bank.slug]?.description ?? defaultMissedCallDesc;
const pageDesc = !isMissedCall
  ? (seoOverrides[bank.slug]?.description ?? `${bank.name} balance check number ${bank.missedCall}। यह customer-care/IVR line है; dedicated missed-call service verified नहीं है।`)
  : requestedMissedCallDesc.length <= 155
    ? requestedMissedCallDesc
    : compactMissedCallDesc;
---

<Layout title={pageTitle} description={pageDesc} preloadImage="/videos/balcheck-poster.jpg">
<script type="application/ld+json" set:html={JSON.stringify(bankSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- Breadcrumb -->
<nav class="max-w-4xl mx-auto px-4 pt-4" aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-sm text-gray-500 flex-wrap">
    <li><a href="/" class="inline-block py-1.5 px-2 -ml-2 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">होम</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li><a href={`/banks/${catSlug}/`} class="inline-block py-1.5 px-1 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">{categoryHindi[bank.category]}</a></li>
    <li aria-hidden="true" class="text-gray-400">›</li>
    <li class="text-gray-900 font-medium py-1.5 px-1">{bank.nameHindi}</li>
  </ol>
</nav>

<!-- Merger banner — only for old pre-merger slugs that still have a /bank/ page -->
{merger && firstEvent && finalEvent && (
  <div class="max-w-4xl mx-auto px-4 pt-4">
    <div class="bg-amber-50 rounded-xl border-2 border-amber-200 p-4">
      <p class="text-sm sm:text-base text-amber-900 font-medium">
        ⚠️ {bank.nameHindi} अब अलग बैंक के रूप में मौजूद नहीं है — {firstEvent.effectiveDate} को {firstEvent.resultingNameHindi} में विलय हुआ। वर्तमान successor {finalEvent.resultingNameHindi} है।
      </p>
      <a href={`/merged-banks/${merger.oldSlug}/`} class="mt-2 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800 underline">
        विलय की पूरी जानकारी और नया balance check number देखें →
      </a>
    </div>
  </div>
)}

<!-- Video Hero Banner — universal on all bank pages -->
<VideoHeroBanner
  src="/videos/balcheck-bank-hero.mp4"
  poster="/videos/balcheck-poster.jpg"
  title={`${bank.nameHindi} बैलेंस चेक नंबर`}
  subtitle={isMissedCall ? `अपने बैंक खाते का बैलेंस जानें — मिस्ड कॉल दें` : `Customer Care / IVR से balance enquiry करें`}
  ctaText={`Call Now: ${bank.missedCall}`}
  ctaHref={`tel:${bank.missedCall}`}
  headingLevel={2}
/>

<!-- Quick Answer — featured snippet bait -->
<section class="bg-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-4">
    <p class="text-base sm:text-lg text-gray-900">
      <span class="font-bold">{bank.nameHindi} बैलेंस चेक नंबर:</span>
      <a href={`tel:${bank.missedCall}`} class="text-brand-700 font-bold underline">{bank.missedCall}</a>
      <span class="text-gray-600"> — {serviceInstruction}</span>
    </p>
  </div>
</section>

<!-- Bank Detail Hero -->
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">{bank.slug === 'psb' ? psbH1 : bank.nameHindi}</h1>
        <p class="text-sm text-gray-500 mt-1">{bank.name} · {categoryHindi[bank.category]}</p>
      </div>
      <span class="text-xs font-medium text-brand-700 bg-brand-100 px-3 py-2 rounded-full">{bank.shortName}</span>
    </div>

    {bank.slug === 'psb' && (
      <div class="mt-4 bg-brand-50 rounded-xl border border-brand-100 p-4">
        <p class="text-sm text-gray-700 leading-relaxed">
          <strong>PSB</strong> <span lang="en">Punjab &amp; Sind Bank</span> — पंजाब एंड सिंध बैंक — का ही छोटा नाम है। बैलेंस चेक करने के लिए नंबर वही है चाहे आप PSB, Punjab &amp; Sind Bank या पंजाब एंड सिंध बैंक लिखकर खोजें: registered mobile से <a href={`tel:${bank.missedCall}`} class="text-brand-700 font-bold underline">{bank.missedCall}</a> पर मिस्ड कॉल दें और SMS में बैलेंस पाएं।
        </p>
      </div>
    )}

    <!-- Missed Call Number — big -->
    <div data-testid="primary-balance-service" class="mt-6 bg-white rounded-2xl border-2 border-brand-200 p-5 shadow-sm">
      <p class="text-sm text-brand-700 font-medium mb-1">📞 {serviceLabel}</p>
      <a href={`tel:${bank.missedCall}`} class="block">
        <span class="text-3xl sm:text-4xl font-bold text-brand-700 tracking-wide">{bank.missedCall}</span>
      </a>
      <a
        href={`tel:${bank.missedCall}`}
        class="mt-4 w-full flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-medium py-3.5 rounded-xl transition-colors text-base min-h-[48px]"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {isMissedCall ? 'अभी मिस्ड कॉल दें' : 'Customer Care / IVR पर कॉल करें'}
      </a>
    </div>

    {bank.missedCallAlt && (
      <div class="mt-3 bg-amber-50 rounded-lg p-3 border border-amber-200">
        <p class="text-xs text-amber-800">वैकल्पिक नंबर: <span class="font-bold">{bank.missedCallAlt}</span></p>
      </div>
    )}

    {bank.notes && (
      <div class="mt-3 bg-amber-50 rounded-lg p-3 border border-amber-200">
        <p class="text-xs text-amber-800">⚠️ {bank.notes}</p>
      </div>
    )}

    <!-- WhatsApp Share -->
    <a
      href={`https://wa.me/?text=${encodeURIComponent(`${bank.nameHindi} का balance enquiry number: ${bank.missedCall}${isMissedCall ? ' (missed call)' : ' (customer care/IVR)'} — ${siteUrl}/bank/${bank.slug}/`)}`}
      target="_blank"
      rel="noopener"
      class="mt-3 inline-flex items-center gap-2 text-sm text-green-700 bg-green-50 hover:bg-green-100 px-4 py-2 rounded-lg transition-colors"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      WhatsApp पर शेयर करें
    </a>
  </div>
</section>

<!-- Info Grid -->
<section class="max-w-4xl mx-auto px-4 py-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Customer Care -->
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-xs text-gray-500 font-medium mb-1">🎧 Customer Care</p>
      <a href={`tel:${bank.customerCare}`} class="text-lg font-bold text-gray-900">{bank.customerCare}</a>
      <a href={`/customer-care/${bank.slug}/`} class="block text-xs text-brand-600 font-medium mt-2 hover:text-brand-700">Customer care details →</a>
    </div>
    <!-- Website -->
    <a href={bank.website} target="_blank" rel="noopener" class="bg-white rounded-xl border border-gray-200 p-4 hover:border-brand-300 transition-colors">
      <p class="text-xs text-gray-500 font-medium mb-1">🌐 आधिकारिक वेबसाइट</p>
      <span class="text-sm font-bold text-brand-600 break-all">{bank.website.replace('https://www.', '').replace('https://', '')}</span>
    </a>
  </div>
</section>

<!-- WhatsApp Banking — honest channel answer, only for banks with a checked official site -->
{waCheck && (
  <section data-testid="whatsapp-banking" class="bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <h2 class="text-xl font-bold text-gray-900 mb-3">{bank.nameHindi} — WhatsApp बैंकिंग नंबर</h2>
      <div class="bg-amber-50 rounded-xl border border-amber-200 p-4">
        <p class="text-sm text-gray-800 leading-relaxed">
          <strong>नहीं</strong> — {bank.name} की आधिकारिक वेबसाइट (<a href={waCheck.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-brand-700 underline break-all">{waCheck.sourceUrl.replace('https://', '')}</a>) पर WhatsApp बैंकिंग का कोई नंबर नहीं दिया गया है ({waCheck.checkedOn} को जांचा गया)।
        </p>
        <p class="text-sm text-gray-800 leading-relaxed mt-2">
          बैलेंस जानने के लिए <a href={`tel:${bank.missedCall}`} class="text-brand-700 font-bold underline">{bank.missedCall}</a> पर रजिस्टर्ड मोबाइल से <strong>मिस्ड कॉल</strong> दें — कॉल 2-3 ring के बाद कटेगी और SMS में तुरंत बैलेंस आ जाएगा। इसके अलावा <strong>M-Tarang</strong> मोबाइल ऐप या toll-free customer care <a href={`tel:${bank.customerCare}`} class="text-brand-700 underline">{bank.customerCare}</a> भी इस्तेमाल कर सकते हैं।
        </p>
        <p class="text-xs text-gray-700 leading-relaxed mt-2">
          ⚠️ सावधानी: Google या किसी ब्लॉग/एग्रीगेटर पर दिखने वाला कोई भी "{bank.shortName} WhatsApp नंबर" आधिकारिक नहीं है — ऐसे नंबर पर मैसेज न भेजें, न कोई OTP/जानकारी साझा करें। बैंक की ओर से अभी तक WhatsApp बैंकिंग शुरू होने पर ही इस पेज पर नंबर दिखाया जाएगा।
        </p>
      </div>
      <p class="text-xs text-gray-500 mt-3">स्रोत: {bank.name} official website, जांच तिथि {waCheck.checkedOn}</p>
    </div>
  </section>
)}

<!-- How It Works -->
<section class="bg-white border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-gray-900 mb-6">{bank.nameHindi} से बैलेंस कैसे चेक करें?</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="flex items-start gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">1</div>
        <div>
          <h3 class="font-semibold text-gray-900 text-sm">{isMissedCall ? 'मिस्ड कॉल दें' : 'Customer Care / IVR पर कॉल करें'}</h3>
          <p class="text-xs text-gray-500 mt-0.5">{bank.missedCall} पर रजिस्टर्ड मोबाइल से कॉल करें</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">2</div>
        <div>
          <h3 class="font-semibold text-gray-900 text-sm">{isMissedCall ? 'कॉल कट जाएगी' : 'Balance enquiry चुनें'}</h3>
          <p class="text-xs text-gray-500 mt-0.5">{isMissedCall ? '2-3 ring के बाद कॉल अपने आप कट जाएगी' : 'IVR menu में balance enquiry विकल्प चुनें'}</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">3</div>
        <div>
          <h3 class="font-semibold text-gray-900 text-sm">{isMissedCall ? 'SMS में बैलेंस' : 'IVR निर्देश पूरा करें'}</h3>
          <p class="text-xs text-gray-500 mt-0.5">{isMissedCall ? 'कुछ सेकंड में SMS आ जाएगा' : 'Bank के निर्देशों के अनुसार verification करें'}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="bg-gray-50 border-t border-gray-100">
  <div class="max-w-3xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-gray-900 text-center mb-6">{bank.shortName} — अक्सर पूछे जाने वाले प्रश्न</h2>
    <div class="space-y-3">
      {faqs.map(faq => (
        <details class="bg-white rounded-lg border border-gray-200 p-4 group">
          <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center gap-2">
            {faq.q}
            <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Predecessor banks (reverse merger links — successor pages only) -->
{predecessors.length > 0 && (
  <section class="bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-6">
      <h2 class="text-sm font-bold text-gray-900 mb-3">पूर्व बैंक — {bank.nameHindi} में विलय हुई बैंकें</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {predecessors.map(p => (
          <a href={`/merged-banks/${p.oldSlug}/`} class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
            <p class="text-xs text-gray-500">{p.oldName}</p>
            <p class="text-xs font-medium text-brand-700 mt-1">विलय की जानकारी →</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Banking Services Cross-Links -->
<section class="bg-gray-50 border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-6">
    <h2 class="text-sm font-bold text-gray-900 mb-3">{bank.shortName} — अन्य सेवाएं</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <a href={`/customer-care/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">🎧 Customer Care</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Helpline →</p>
      </a>
      <a href={`/sms-banking/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">📱 SMS Banking</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Balance by SMS →</p>
      </a>
      <a href={`/net-banking/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">🌐 Net Banking</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Login →</p>
      </a>
      <a href={`/mini-statement/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">📄 Mini Statement</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Last 5 Txns →</p>
      </a>
      <a href={`/mobile-number-registration/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">📱 Mobile Registration</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Register Number →</p>
      </a>
      <a href={`/aadhaar-link/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">🔗 Aadhaar Link</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Link Aadhaar →</p>
      </a>
      <a href={`/atm-pin/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">🔑 ATM PIN</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Generate PIN →</p>
      </a>
      <a href={`/balance-enquiry/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">💰 Balance Enquiry</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Check Balance →</p>
      </a>
      <a href={`/toll-free-number/${bank.slug}/`}
         class="bg-white rounded-lg border border-gray-200 p-3 text-center hover:border-brand-300 hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500">🆓 Toll Free Number</p>
        <p class="text-xs font-medium text-brand-700 mt-1">Helpline →</p>
      </a>
    </div>
  </div>
</section>

<!-- Related Banks -->
{related.length > 0 && (
  <section class="bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <h2 class="text-lg font-bold text-gray-900 mb-4">{categoryHindi[bank.category]} — अन्य बैंक</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {related.map(rb => (
          <a href={`/bank/${rb.slug}/`} class="flex items-center justify-between bg-white rounded-lg border border-gray-200 p-4 hover:border-brand-300 hover:shadow-sm active:bg-gray-50 transition-all min-h-[56px]">
            <div>
              <p class="font-semibold text-gray-900 text-sm">{rb.nameHindi}</p>
              <p class="text-xs text-gray-500">{rb.shortName}</p>
            </div>
            <span class="text-sm font-bold text-brand-600">{rb.missedCall}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Cheatsheet PDF CTA -->
<section class="bg-gradient-to-r from-brand-600 to-brand-800">
  <div class="max-w-4xl mx-auto px-4 py-6">
    <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
      <div class="text-4xl shrink-0">📄</div>
      <div class="flex-1">
        <h2 class="text-base font-bold text-white mb-0.5">सभी 79 बैंक नंबर एक PDF में</h2>
        <p class="text-xs text-brand-100">ऑफलाइन रखें, प्रिंट करें — बिना इंटरनेट के भी नंबर हाथ में</p>
      </div>
      <a href="https://upseva.in/tools/bank-cheatsheet/" target="_blank" rel="noopener" class="shrink-0 inline-flex items-center gap-1.5 bg-white text-brand-700 font-bold text-sm px-5 py-2.5 rounded-lg hover:bg-brand-50 transition-colors shadow whitespace-nowrap">
        PDF पाएं →
      </a>
    </div>
  </div>
</section>

<!-- Disclaimer -->
<footer class="bg-gray-50 border-t border-gray-200">
  <div class="max-w-4xl mx-auto px-4 py-6">
    {bank.notes === "needs_verification" ? (
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
        <p class="text-sm text-yellow-800 font-medium">
          ⚠️ यह नंबर अभी सत्यापित नहीं है
        </p>
        <p class="text-xs text-yellow-700 mt-1">
          हम इस नंबर की पुष्टि करने में असमर्थ रहे हैं। कृपया {bank.name} की आधिकारिक वेबसाइट पर जाकर सही नंबर जांचें।
        </p>
        <a href={bank.website} target="_blank" rel="noopener" 
          class="inline-block mt-2 text-xs bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full hover:bg-yellow-200">
          आधिकारिक वेबसाइट देखें →
        </a>
      </div>
    ) : (
      <p class="text-xs text-gray-500 leading-relaxed">
        ✅ यह नंबर {bank.name} की आधिकारिक वेबसाइट से सत्यापित है। बैंक कभी-कभी नंबर बदल सकते हैं। कृपया <a href={bank.website} target="_blank" rel="noopener" class="text-brand-600 underline">आधिकारिक वेबसाइट</a> से सत्यापित करें।
      </p>
    )}
    
    <div class="mt-4 flex flex-wrap gap-3">
      <a href={`https://wa.me/?text=${encodeURIComponent(`${bank.name} का बैलेंस चेक नंबर: ${bank.missedCall} | BalCheck.in`)}`}
        target="_blank" rel="noopener"
        class="inline-flex items-center gap-2 bg-green-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-green-600 transition-colors">
        📱 WhatsApp पर शेयर करें
      </a>
      
      <a href={`mailto:report@balcheck.in?subject=${encodeURIComponent(`Wrong number: ${bank.name} (${bank.missedCall})`)}&body=${encodeURIComponent(`Bank: ${bank.name}\nCurrent number: ${bank.missedCall}\nPage: https://balcheck.in/bank/${bank.slug}\n\nPlease provide the correct number:`)}`}
        class="inline-flex items-center gap-2 bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-200 transition-colors">
        🚫 गलत नंबर रिपोर्ट करें
      </a>
    </div>
    
    <p class="text-xs text-gray-600 mt-4">
      BalCheck.in किसी भी बैंक का आधिकारिक प्रतिनिधि नहीं है। सभी नंबर सार्वजनिक स्रोतों से लिए गए हैं।
    </p>
  </div>
</footer>
</Layout>
