---
import Layout from '../../layouts/Layout.astro';
import { banks, categories, categoryHindi } from '../../data/banks';

const siteUrl = 'https://balcheck.in';
const canonicalUrl = `${siteUrl}/missed-call/`;

const title = `Bank Missed Call Number List — ${banks.length} बैंकों के Balance Check Numbers | BalCheck.in`;
const description = `${banks.length} भारतीय बैंकों के missed call balance check numbers एक जगह। अपने बैंक का नंबर ढूंढें, registered mobile से मिस्ड कॉल दें और SMS में बैलेंस पाएं।`;

const isMissedCall = (bank: (typeof banks)[number]) => bank.balanceMode === 'missed-call';
const missedCallBanks = banks.filter(isMissedCall);

// FAQ answered from real GSC queries (window 2026-06-13 → 2026-09-08):
// 'missed call se balance kaise check kare' cluster, 'missed call number'
// list/directory intent, and the 124 bare 10-digit raw-number queries
// (e.g. '09223766666' 2,107i/20c, '9986454440' 2,645i/17c, '8886610360' 1,966i/8c).
const faqs = [
  {
    q: 'मिस्ड कॉल से बैंक बैलेंस कैसे चेक करें?',
    a: `अपने बैंक का balance enquiry नंबर ऊपर की सूची में ढूंढें और उस पर अपने बैंक में रजिस्टर्ड मोबाइल नंबर से मिस्ड कॉल दें। कॉल 2-3 ring के बाद अपने आप कट जाएगी और कुछ सेकंड में SMS में आपका अकाउंट बैलेंस आ जाएगा। कॉल करने से पहले जांच लें कि आपका मोबाइल नंबर बैंक खाते से लिंक है।`,
  },
  {
    q: 'मिस्ड कॉल बैलेंस enquiry से पैसा कटता है या फ्री है?',
    a: `अधिकांश बैंकों की missed-call balance enquiry सेवा फ्री है — कॉल जवाब में जुड़ती नहीं, इसलिए कॉल charges लागू नहीं होते। लेकिन हर बैंक और telecom operator की शर्तें अलग हो सकती हैं, इसलिए अपने बैंक की official website पर एक बार जांच लें। इस पेज पर दिए customer-care/IVR नंबरों पर सामान्य कॉल शुल्क लागू हो सकते हैं।`,
  },
  {
    q: 'मिस्ड कॉल नंबर पर कॉल नहीं उठा तो बैलेंस कैसे पता करें?',
    a: `पहले जांचें कि आपने सही नंबर सही ढंग से डायल किया है और आपका नंबर बैंक में रजिस्टर्ड है। 2-3 बार कोशिश करने के बाद भी SMS न आए तो बैंक का customer care नंबर ट्राई करें, बैंक की official app या net banking से बैलेंस देखें, या ATM से बैलेंस enquiry करें। हर बैंक के सभी तरीके /bank/[slug] पेज पर दिए हैं।`,
  },
  {
    q: 'क्या मिस्ड कॉल से बैलेंस जानने के लिए OTP या PIN चाहिए?',
    a: `नहीं। असली missed-call balance enquiry में कभी भी OTP, PIN, CVV या password नहीं मांगा जाता — यह सेवा बिना कॉल जवाब में जुड़े, अकेले SMS पर काम करती है। अगर कोई कॉल या SMS आपसे ये जानकारी मांगे, तो यह फ्रॉड है। OTP/PIN कभी किसी के साथ साझा न करें — बैंक भी नहीं मांगता।`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Bank Missed Call Balance Enquiry Numbers',
  numberOfItems: missedCallBanks.length,
  itemListElement: banks.map((bank, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `${bank.name} — ${bank.missedCall}`,
    url: `${siteUrl}/bank/${bank.slug}/`,
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bank Missed Call Number List — Balance Check by Missed Call',
  description,
  url: canonicalUrl,
  mainEntity: itemListSchema,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Missed Call Numbers', item: canonicalUrl },
    ],
  },
};
---

<Layout title={title} description={description} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <nav class="max-w-4xl mx-auto px-4 pt-4" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-sm text-gray-500 flex-wrap">
      <li><a href="/" class="inline-block py-1.5 px-2 -ml-2 rounded-lg hover:text-brand-600 hover:bg-gray-100 active:bg-gray-200 transition-colors">होम</a></li>
      <li aria-hidden="true" class="text-gray-400">›</li>
      <li class="text-gray-900 font-medium py-1.5 px-1">Missed Call Numbers</li>
    </ol>
  </nav>

  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Bank Missed Call Balance Enquiry Numbers</h1>
      <p class="mt-2 text-gray-600 text-sm sm:text-base leading-relaxed">
        {banks.length} भारतीय बैंकों के balance enquiry नंबर एक जगह — अपने बैंक या नंबर से खोजें, registered mobile से मिस्ड कॉल दें और SMS में तुरंत बैलेंस पाएं।
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-6">
    <!-- How missed-call balance enquiry works -->
    <section class="mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-3">मिस्ड कॉल से बैलेंस कैसे चेक करें?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">1</div>
          <div>
            <h3 class="font-semibold text-gray-900 text-sm">नंबर ढूंढें</h3>
            <p class="text-xs text-gray-500 mt-0.5">नीचे सूची से अपने बैंक का balance enquiry नंबर लें</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">2</div>
          <div>
            <h3 class="font-semibold text-gray-900 text-sm">मिस्ड कॉल दें</h3>
            <p class="text-xs text-gray-500 mt-0.5">registered mobile से कॉल करें — 2-3 ring के बाद अपने आप कट जाएगी</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-600 font-bold shrink-0">3</div>
          <div>
            <h3 class="font-semibold text-gray-900 text-sm">SMS में बैलेंस</h3>
            <p class="text-xs text-gray-500 mt-0.5">कुछ सेकंड में SMS में अकाउंट बैलेंस आ जाएगा</p>
          </div>
        </div>
      </div>

      <div class="mt-4 bg-brand-50 rounded-xl border border-brand-100 p-4">
        <p class="text-sm text-gray-700 leading-relaxed">
          Missed-call सेवा में कॉल आम तौर पर जवाब में जुड़ती नहीं, इसलिए अधिकांश बैंकों में इससे कोई शुल्क नहीं लगता — बैलेंस सीधे SMS में आ जाता है। इसके लिए ज़रूरी है कि आपका मोबाइल नंबर बैंक खाते से रजिस्टर्ड हो। अगर कॉल नहीं उठती या SMS नहीं आता, तो कुछ बैंकों में customer care/IVR नंबर भी दिया गया है — उस पर सामान्य कॉल शुल्क लागू हो सकते हैं।
        </p>
      </div>

      <div class="mt-3 bg-red-50 rounded-xl border border-red-200 p-4">
        <p class="text-sm text-red-800 leading-relaxed">
          🔒 सुरक्षा की बात: असली balance-enquiry सेवा में बैंक कभी OTP, PIN, CVV या password नहीं मांगता। कॉल पर कोई ये पूछे तो फ्रॉड समझें और कुछ साझा न करें। नंबर बदल सकते हैं — इस्तेमाल से पहले बैंक की official website पर जांच लें।
        </p>
      </div>
    </section>

    <!-- Bank numbers grouped by category; every number is visible selectable text -->
    <section>
      <h2 class="text-xl font-bold text-gray-900 mb-4">{banks.length} बैंकों के नंबर</h2>
      {categories.map(cat => {
        const catBanks = banks.filter(b => b.category === cat);
        return (
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
              {categoryHindi[cat]}
              <span class="text-sm font-normal text-gray-500">({cat} · {catBanks.length})</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {catBanks.map(bank => (
                <div class="bg-white rounded-xl border border-gray-200 p-4">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <a href={`/bank/${bank.slug}/`} class="inline-flex min-h-[24px] items-center font-bold text-gray-900 text-sm hover:text-brand-600 transition-colors">
                        {bank.nameHindi}
                      </a>
                      <p class="text-xs text-gray-500">{bank.name}</p>
                    </div>
                    <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded shrink-0">
                      {bank.shortName}
                    </span>
                  </div>
                  <div class="mt-3 flex items-center justify-between gap-2">
                    <a href={`tel:${bank.missedCall}`} class="text-lg font-bold text-brand-700 tracking-wide">
                      {bank.missedCall}
                    </a>
                    <div class="flex items-center gap-2">
                      <a
                        href={`tel:${bank.missedCall}`}
                        class="inline-flex items-center justify-center gap-1 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white text-xs font-medium px-3 py-2 rounded-lg transition-colors min-h-[40px]"
                      >
                        कॉल करें
                      </a>
                      <button
                        type="button"
                        data-copy-number={bank.missedCall}
                        class="inline-flex items-center justify-center text-xs font-medium text-gray-600 border border-gray-200 px-2 py-2 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[40px] min-w-[40px]"
                        aria-label={`${bank.nameHindi} का नंबर कॉपी करें`}
                        aria-live="polite"
                      >
                        कॉपी
                      </button>
                      <a
                        href={isMissedCall(bank) ? `/missed-call/${bank.slug}/` : `/balance-enquiry/${bank.slug}/`}
                        class="inline-flex items-center justify-center text-xs font-medium text-brand-700 border border-brand-200 px-3 py-2 rounded-lg hover:bg-brand-50 transition-colors min-h-[40px]"
                      >
                        Details
                      </a>
                    </div>
                  </div>
                  <p class="mt-2 text-xs text-gray-600">
                    {isMissedCall(bank)
                      ? 'Missed call सेवा — बिना कॉल जुड़े SMS में बैलेंस'
                      : 'Customer care/IVR — सामान्य कॉल शुल्क लागू हो सकते हैं'}
                  </p>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </section>

    <!-- FAQ -->
    <section class="bg-gray-50 border-t border-gray-100 rounded-xl">
      <div class="max-w-3xl mx-auto px-4 py-8">
        <h2 class="text-xl font-bold text-gray-900 text-center mb-6">अक्सर पूछे जाने वाले प्रश्न</h2>
        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="bg-white rounded-lg border border-gray-200 p-4 group">
              <summary class="font-medium text-gray-900 cursor-pointer list-none flex justify-between items-center gap-2">
                {faq.q}
                <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-3 text-sm text-gray-600 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Discoverability note -->
    <p class="text-xs text-gray-500 mt-6 leading-relaxed">
      BalCheck.in किसी भी बैंक का आधिकारिक प्रतिनिधि नहीं है। नंबर bank websites और cross-check sources से संकलित किए जाते हैं और बदल सकते हैं। इस्तेमाल से पहले अपने bank की official website पर current details सत्यापित करें।
    </p>
  </div>
</Layout>

<script>
  // Copy number to clipboard (progressive enhancement — number text always visible)
  document.querySelectorAll('[data-copy-number]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const number = (btn as HTMLElement).dataset.copyNumber || '';
      try {
        await navigator.clipboard.writeText(number);
        const original = btn.textContent;
        btn.textContent = 'कॉपी हुआ ✓';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch {
        // clipboard unavailable (older browsers) — number text remains selectable
      }
    });
  });
</script>
