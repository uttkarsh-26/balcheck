---
import Layout from '../../layouts/Layout.astro';
import { getArticle } from '../../data/articles';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ScannableArticleSummary from '../../components/ScannableArticleSummary.astro';

const siteUrl = 'https://balcheck.in';
const slug = 'delhi-consumer-court-cyber-fraud-bank-refund-2026';
const publishDate = '2026-11-16';
const modifiedDate = '2026-11-16';
const pageTitle = getArticle(slug).title;
const pageDesc = getArticle(slug).description;

const articleBrief = {
  summary:
    'Delhi consumer court ने 2016 के cyber fraud में private bank को ₹70,084 refund और ₹25,000 मुआवज़ा देने का आदेश दिया, क्योंकि ग्राहक ने 3 working days के भीतर सूचना दी थी।',
  facts: [
    { label: 'नुकसान', value: '₹70,084 — 9 जुलाई 2016 को unauthorised online debits' },
    { label: 'सूचना', value: 'ग्राहक ने 10 जुलाई 2016 को bank को बताया — 3 working days के भीतर' },
    { label: 'आदेश', value: '30 अक्टूबर 2026 — refund ₹70,084 + ₹25,000 compensation व litigation cost' },
    { label: 'आधार', value: 'RBI circular (6 जुलाई 2017) — third-party breach में 3 कार्यदिन में सूचना पर bank की liability' },
    { label: 'स्रोत', value: 'Indian Express व The New Indian Express, 13 नवंबर 2026' },
  ],
  timeline: [
    {
      date: '9 जुलाई 2016',
      datetime: '2016-07-09',
      text: 'ग्राहक के savings account से unauthorised online transactions हुए और ₹70,084 कट गए।',
    },
    {
      date: '10 जुलाई 2016',
      datetime: '2016-07-10',
      text: 'ग्राहक ने bank को लिखित सूचना दी — यानी 3 working days की समय-सीमा के भीतर; bank ने रकम वापस नहीं की।',
    },
    {
      date: '30 अक्टूबर 2026',
      datetime: '2026-10-30',
      text: 'Delhi consumer commission ने bank को deficiency in service का दोषी मानकर refund और मुआवज़े का आदेश दिया।',
    },
    {
      date: '13 नवंबर 2026',
      datetime: '2026-11-13',
      text: 'Indian Express और The New Indian Express ने आदेश की रिपोर्ट प्रकाशित की।',
    },
  ],
  action: {
    title: 'Cyber fraud में पैसा कटे तो यह क्रम अपनाएँ',
    steps: [
      'उसी दिन bank की customer care को call करें, transaction की जानकारी दें, account/card block कराएँ और लिखित complaint की acknowledgement लें।',
      'cybercrime.gov.in पर NCRP complaint दर्ज करें या helpline 1930 पर call करें — तारीख, रकम और transaction reference साथ रखें।',
      'Bank written complaint के 30 दिन में समाधान न हो तो RBI Integrated Ombudsman (cms.rbi.org.in) पर शिकायत करें।',
