---
import Layout from '../../layouts/Layout.astro';
import MoreServices from '../../components/MoreServices.astro';
import { banks } from '../../data/banks';
import type { Bank } from '../../data/banks';

export function getStaticPaths() {
  return banks.map((bank: Bank) => ({ params: { slug: bank.slug }, props: { bank } }));
}

interface Props { bank: Bank }
const { bank } = Astro.props;
const siteUrl = 'https://balcheck.in';
const canonicalUrl = `${siteUrl}/mini-statement/${bank.slug}/`;
const hasDedicatedNumber = Boolean(bank.missedCallAlt);
const transactionCount = bank.slug === 'kvb' ? 3 : 5;
const displayName = ({ axis: 'Axis Bank', federal: 'Federal Bank' } as Record<string, string>)[bank.slug] ?? bank.shortName;
const title = hasDedicatedNumber
  ? `${bank.shortName} Mini Statement Number ${bank.missedCallAlt} | BalCheck`
  : `${displayName} Mini Statement — Official Methods | BalCheck`;
const hasDocumentedEvidence = Boolean(bank.verificationSource && bank.lastVerified);
const documentedTransactionCount = hasDedicatedNumber && hasDocumentedEvidence ? transactionCount : null;
const description = hasDedicatedNumber
  ? documentedTransactionCount
    ? `${bank.name} verified mini statement number ${bank.missedCallAlt}. Registered mobile से missed call देकर last ${documentedTransactionCount} transactions पाएं।`
    : `${bank.name} recorded mini statement number ${bank.missedCallAlt}. Exact transaction count के लिए official website या customer care ${bank.customerCare} से confirm करें।`
  : `${bank.name} का dedicated mini-statement missed-call number verified नहीं है। ATM, official app, net banking या customer care ${bank.customerCare} का उपयोग करें।`;
const h1Text = hasDedicatedNumber ? `${bank.shortName} Mini Statement Number` : `${displayName} Mini Statement`;
const websiteHost = bank.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const accessSteps = hasDedicatedNumber ? [
  `${bank.name} account में registered mobile number तैयार रखें।`,
  `${bank.missedCallAlt} पर missed call दें और bank को call disconnect करने दें।`,
  documentedTransactionCount
    ? `SMS आने का इंतज़ार करें; last ${documentedTransactionCount} transactions को date और amount के साथ check करें।`
    : `SMS आने का इंतज़ार करें और recent transactions check करें। Exact transaction count इस record में documented नहीं है।`,
  `SMS न आए तो network/mobile registration check करके ${bank.customerCare} पर official help लें।`,
] : [
  `Balance number ${bank.missedCall} को mini-statement number न मानें; dedicated mini-statement missed-call number verified नहीं है।`,
  `${bank.shortName} ATM में debit card डालकर “Mini Statement” option चुनें, या official app/net banking में recent transactions खोलें।`,
  `Digital method उपलब्ध न हो तो passbook update कराएं या ${bank.customerCare} पर official process पूछें।`,
  `Latest service availability और safe login path ${bank.website} पर confirm करें।`,
];

const faqs = [
  {
    q: `${bank.shortName} mini statement कैसे प्राप्त करें?`,
    a: hasDedicatedNumber
      ? documentedTransactionCount
        ? `Registered mobile से verified number ${bank.missedCallAlt} पर missed call दें। SMS में last ${documentedTransactionCount} transactions मिलेंगे।`
        : `Registered mobile से recorded number ${bank.missedCallAlt} पर missed call दें। SMS में recent transactions मिल सकते हैं; exact count के लिए ${bank.website} से confirm करें।`
      : `Dedicated mini-statement missed-call number verified नहीं है। ${bank.name} की official app, net banking, ATM या customer care ${bank.customerCare} का उपयोग करें।`,
  },
  {
    q: `Mini statement नहीं मिले तो क्या करें?`,
    a: `Official website ${bank.website} पर current instructions देखें या customer care ${bank.customerCare} से पुष्टि करें। OTP, PIN या CVV किसी से share न करें।`,
  },
  {
    q: `${bank.shortName} balance number से mini statement मिलेगा?`,
    a: hasDedicatedNumber ? `नहीं, balance number और dedicated mini-statement number अलग हो सकते हैं। ${bank.name} का recorded mini-statement number ${bank.missedCallAlt} है; balance number ${bank.missedCall} को इसके स्थान पर use न करें।` : `Dedicated mini-statement number verified नहीं है। Balance number ${bank.missedCall} को mini-statement number न मानें। ATM, official app, net banking या customer care ${bank.customerCare} उपयोग करें।`,
  },
  {
    q: `Mini statement में कितने transactions दिखते हैं?`,
    a: documentedTransactionCount ? `${bank.shortName} के documented missed-call flow में last ${documentedTransactionCount} transactions मिलते हैं। Exact fields और response timing bank service पर निर्भर है।` : `Exact transaction count इस record में documented नहीं है। ATM, app और net banking अलग-अलग count दिखा सकते हैं; full period के लिए official account statement download करें।`,
  },
  {
    q: `Mini statement और full account statement में क्या फर्क है?`,
    a: `Mini statement recent debit/credit entries का छोटा summary है। Full account statement चुनी हुई date range, opening/closing balance और अधिक transaction detail देता है। Loan, tax या dispute proof के लिए official full statement उपयोग करें।`,
  },
];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Mini Statement', item: `${siteUrl}/mini-statement/` },
      { '@type': 'ListItem', position: 3, name: bank.shortName, item: canonicalUrl },
    ],
  },
];
if (hasDedicatedNumber) {
  graph.unshift({
    '@type': 'HowTo',
    name: `${bank.shortName} Mini Statement कैसे प्राप्त करें`,
    description: documentedTransactionCount
      ? `${bank.name} के verified dedicated mini-statement number से last ${documentedTransactionCount} transactions प्राप्त करें।`
      : `${bank.name} के recorded mini-statement number से recent transactions प्राप्त करें; exact count official source से confirm करें।`,
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Registered mobile से call करें', text: `${bank.missedCallAlt} पर missed call दें।` },
      { '@type': 'HowToStep', position: 2, name: 'SMS प्राप्त करें', text: documentedTransactionCount ? `SMS में last ${documentedTransactionCount} transactions प्राप्त करें।` : `SMS में recent transactions देखें; exact count bank service पर निर्भर है।` },
    ],
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<Layout title={title} description={description} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main data-testid="mini-statement-guide" class="max-w-3xl mx-auto px-4 py-6">
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/">Home</a><span class="mx-1">›</span><a href="/mini-statement/">Mini Statement</a><span class="mx-1">›</span><span>{bank.shortName}</span>
    </nav>
    <div class="bg-gradient-to-br from-brand-600 to-brand-800 rounded-2xl p-6 text-white mb-6">
      <h1 class="text-2xl font-bold mb-1">{h1Text}</h1>
      <p class="text-brand-100 text-sm">{bank.nameHindi} — हाल के लेन-देन की जानकारी</p>
    </div>

    <section class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
      <h2 class="text-lg font-semibold text-blue-950 mb-2">सीधा जवाब</h2>
      <p class="text-sm text-blue-900 leading-relaxed">{hasDedicatedNumber ? documentedTransactionCount ? `${bank.name} का documented dedicated mini-statement number ${bank.missedCallAlt} है। Registered mobile से missed call देकर last ${documentedTransactionCount} transactions का SMS पाएं।` : `${bank.name} का recorded mini-statement number ${bank.missedCallAlt} है। Registered mobile से missed call दें; exact transaction count इस record में documented नहीं है।` : `${bank.name} के लिए dedicated mini-statement missed-call number verified नहीं है। Balance number ${bank.missedCall} को mini-statement number न मानें; ATM, official app, net banking या customer care ${bank.customerCare} उपयोग करें।`}</p>
      <a href={`tel:${hasDedicatedNumber ? bank.missedCallAlt : bank.customerCare}`} class="mt-4 inline-flex bg-brand-600 text-white px-5 py-2.5 rounded-lg font-medium">📞 {hasDedicatedNumber ? bank.missedCallAlt : bank.customerCare}</a>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-4">{bank.shortName} mini-statement snapshot</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Bank</dt><dd class="font-medium text-gray-900">{bank.name} · {bank.nameHindi}</dd></div>
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Category</dt><dd class="font-medium text-gray-900">{bank.category}</dd></div>
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Dedicated mini-statement number</dt><dd class="font-medium text-gray-900">{hasDedicatedNumber ? bank.missedCallAlt : 'verified नहीं'}</dd></div>
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Balance number (different purpose)</dt><dd class="font-medium text-gray-900">{bank.missedCall}</dd></div>
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Customer care fallback</dt><dd class="font-medium text-gray-900">{bank.customerCare}</dd></div>
        <div class="rounded-lg bg-gray-50 p-3"><dt class="text-gray-500">Official website</dt><dd><a href={bank.website} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 break-all">{bank.website}</a></dd></div>
      </dl>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      {hasDedicatedNumber ? (
        <>
          <h2 class="text-lg font-semibold mb-3">{documentedTransactionCount ? 'Verified Mini Statement Number' : 'Recorded Mini Statement Number'}</h2>
          <p class="text-gray-700 text-sm mb-4">{bank.name} का {documentedTransactionCount ? 'documented' : 'recorded'} dedicated number <strong>{bank.missedCallAlt}</strong> है। Registered mobile से missed call दें; {documentedTransactionCount ? `SMS में last ${documentedTransactionCount} transactions मिलेंगे।` : 'SMS में recent transactions मिल सकते हैं; exact count official source से confirm करें।'} Balance number {bank.missedCall} को इसके स्थान पर use न करें।</p>
          <a href={`tel:${bank.missedCallAlt}`} class="inline-flex bg-brand-600 text-white px-5 py-2.5 rounded-lg font-medium">📞 {bank.missedCallAlt}</a>
        </>
      ) : (
        <>
          <h2 class="text-lg font-semibold mb-3">Official Mini Statement Methods</h2>
          <p class="text-gray-700 text-sm mb-3">{bank.name} का dedicated mini-statement missed-call number verified नहीं है। Balance number {bank.missedCall} को mini-statement number न मानें।</p>
          <ul class="space-y-2 text-sm text-gray-700 mb-4">
            <li>✓ Official mobile app या net banking में recent transactions देखें</li>
            <li>✓ ATM में “Mini Statement” विकल्प चुनें</li>
            <li>✓ Official instructions के लिए <a href={bank.website} target="_blank" rel="noopener noreferrer" class="text-brand-700 font-medium">bank website</a> देखें</li>
          </ul>
          <a href={`tel:${bank.customerCare}`} class="inline-flex bg-brand-600 text-white px-5 py-2.5 rounded-lg font-medium">Customer Care: {bank.customerCare}</a>
        </>
      )}
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-4">Mini statement पाने के steps</h2>
      <ol class="space-y-3 text-sm text-gray-700">
        {accessSteps.map((step, index) => (
          <li class="flex gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">{index + 1}</span>
            <span class="leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">Mini statement में क्या check करें?</h2>
      <ul class="space-y-2 text-sm text-gray-700 leading-relaxed">
        <li>✓ Recent debit और credit entries की date, amount और transaction type देखें।</li>
        <li>✓ Unknown debit दिखे तो screenshot या SMS सुरक्षित रखें और तुरंत {bank.customerCare} पर report करें।</li>
        <li>✓ Available balance और ledger balance अलग हो सकते हैं; pending card/UPI transaction के कारण difference संभव है।</li>
        <li>✓ Mini statement limited recent history है। Full month, tax, loan या dispute record के लिए official account statement download करें।</li>
        <li>✓ SMS में full account number, OTP, PIN या CVV नहीं होना चाहिए। Suspicious link को open न करें।</li>
      </ul>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">कौन सा method कब use करें?</h2>
      <div class="space-y-4 text-sm text-gray-700 leading-relaxed">
        <div><h3 class="font-semibold text-gray-900">Missed-call SMS</h3><p>{hasDedicatedNumber ? `${bank.missedCallAlt} quick recent-transaction summary के लिए उपयोगी है, जब registered mobile active हो।` : `${bank.shortName} के लिए dedicated number verified नहीं है, इसलिए किसी third-party number पर call या SMS न करें।`}</p></div>
        <div><h3 class="font-semibold text-gray-900">ATM</h3><p>Internet या app access न हो तो {bank.shortName} ATM का “Mini Statement” option चुनें। Card और PIN सुरक्षित रखें; printed slip खुले में न छोड़ें।</p></div>
        <div><h3 class="font-semibold text-gray-900">Official app / net banking</h3><p>Longer transaction list, downloadable PDF और custom date range के लिए {websiteHost} से official login path खोलें। Search ads या SMS link से login न करें।</p></div>
        <div><h3 class="font-semibold text-gray-900">Branch / passbook</h3><p>Dormant account, disputed transaction या digital access failure में branch record और updated passbook बेहतर evidence देते हैं।</p></div>
      </div>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">Mini statement नहीं मिला तो troubleshooting</h2>
      <ol class="space-y-2 text-sm text-gray-700 leading-relaxed">
        <li><strong>1. Number purpose:</strong> {hasDedicatedNumber ? `${bank.missedCallAlt} dedicated mini-statement number है; ${bank.missedCall} balance service के लिए है।` : `Dedicated number verified नहीं है; ${bank.missedCall} केवल recorded balance service है।`}</li>
        <li><strong>2. Mobile registration:</strong> SMS service के लिए account-linked mobile active होना चाहिए। Status branch, ATM या {bank.customerCare} से confirm करें।</li>
        <li><strong>3. Network delay:</strong> कुछ मिनट wait करें; repeated calls या unverified SMS keywords भेजने से बचें।</li>
        <li><strong>4. Safe fallback:</strong> ATM, official app, net banking या passbook से recent transactions check करें।</li>
        <li><strong>5. Transaction dispute:</strong> Unknown debit हो तो mini statement पर निर्भर न रहें; official full statement लें और bank complaint reference save करें।</li>
      </ol>
    </section>

    <section data-testid="mini-statement-evidence" class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6">
      <h2 class="text-lg font-semibold text-amber-950 mb-2">Source और verification status</h2>
      {hasDocumentedEvidence ? (
        <p class="text-sm text-amber-900 leading-relaxed">इस {bank.shortName} record की supporting source details stored हैं और इसे <strong>{bank.lastVerified}</strong> को last reviewed किया गया था। Service बदल सकती है; current number और method के लिए <a href={bank.website} target="_blank" rel="noopener noreferrer" class="font-semibold underline">{bank.website}</a> final authority है।</p>
      ) : (
        <p class="text-sm text-amber-900 leading-relaxed">इस {bank.shortName} record में official website और contact numbers मौजूद हैं, लेकिन detailed source citation और review date stored नहीं है। इसलिए unsupported mini-statement number, exact response time या guaranteed transaction count का दावा नहीं किया गया। Latest process <a href={bank.website} target="_blank" rel="noopener noreferrer" class="font-semibold underline">{bank.website}</a> या {bank.customerCare} से confirm करें।</p>
      )}
    </section>

    <section class="bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">सुरक्षित तरीके</h2>
      <p class="text-sm text-red-900 leading-relaxed">केवल official app, website, ATM और bank customer care का उपयोग करें। OTP, ATM PIN, UPI PIN, CVV या net-banking password कभी share न करें। Fraud लगे तो call बंद करके {bank.customerCare} या official website से दोबारा contact करें।</p>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-lg font-semibold mb-4">अक्सर पूछे जाने वाले प्रश्न</h2>
      <div class="space-y-4">{faqs.map(f => <div><h3 class="font-medium text-sm mb-1">{f.q}</h3><p class="text-gray-600 text-sm leading-relaxed">{f.a}</p></div>)}</div>
    </section>
  </main>

  <div class="max-w-3xl mx-auto px-4 pb-6">
    <MoreServices bank={bank} />
  </div>
</Layout>
