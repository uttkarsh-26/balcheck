---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Path or absolute URL of the social share image (og:image / twitter:image). */
  ogImage?: string;
}

const { title, description = 'भारतीय बैंकों के balance enquiry methods और verified contact details एक जगह', canonical, ogImage = '/og-image.svg' } = Astro.props;
const siteUrl = 'https://balcheck.in';
const canonicalUrl = (canonical ?? new URL(Astro.url.pathname, siteUrl).href).replace(/(?<!:)\/\/$/, '/');
const canonicalHref = canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`;

// HTML: browser always revalidates (max-age=0), CF edge caches 1h with SWR
// Short edge TTL ensures deploys are visible within ~1h even if purge fails
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, max-age=0, stale-while-revalidate=86400');
---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- System fonts only — Noto Sans Devanagari is the default Android Devanagari face;
       Inter is replaced by system-ui (Android Roboto/Fira). Eliminates the
       render-blocking external fonts.googleapis.com chain (PageSpeed 79 -> target 90+). -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">

  <!-- Open Graph / Twitter — absolute URLs per ogp.me and Twitter card spec -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="hi_IN" />
  <meta property="og:site_name" content="BalCheck.in" />
  <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
  <meta property="og:image:alt" content="BalCheck.in — बैंक बैलेंस चेक नंबर directory" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalHref} />

  <!-- Theme color -->
  <meta name="theme-color" content="#2563eb" />

  <!-- Google Analytics (GA4) — production hostname only.
       Dynamic loading prevents localhost/Playwright traffic from polluting GA4. -->
  <script>
    if (window.location.hostname === 'balcheck.in' || window.location.hostname === 'www.balcheck.in') {
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZEL0FEF89W');

      try {
        const params = new URLSearchParams(window.location.search);
        const utmMedium = params.get('utm_medium');

        if (utmMedium && utmMedium.toLowerCase() === 'social') {
          gtag('event', 'social_landing', {
            utm_source: params.get('utm_source') || '',
            utm_campaign: params.get('utm_campaign') || '',
            utm_content: params.get('utm_content') || '',
            landing_path: window.location.pathname,
          });
        }
      } catch (_error) {
        // ignore URL/params parse failures
      }

      const analyticsScript = document.createElement('script');
      analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZEL0FEF89W';
      analyticsScript.async = true;
      document.head.appendChild(analyticsScript);
    }
  </script>

  <!-- Google AdSense (publisher ID verification + loader) -->
  <script
    async
    crossorigin="anonymous"
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2164302228306652"
  ></script>
</head>

<body class="bg-gray-50 font-hindi antialiased">
  <!-- Monetag Multitag (all-in-one monetization) -->
  <script src="https://quge5.com/88/tag.min.js" data-zone="251914" async data-cfasync="false"></script>

  <!-- Keep Monetag's top fixed iframe below the rendered site header without touching bottom formats. -->
  <script is:inline>
    (function() {
      const TOP_AD_THRESHOLD = 100;
      const HEADER_HEIGHT_FALLBACK = 64;
      const MONETAG_Z_INDEX_MIN = 2147480000;

      const positionTopAd = function() {
        const header = document.querySelector('header');
        const headerBottom = header
          ? Math.ceil(header.getBoundingClientRect().bottom)
          : HEADER_HEIGHT_FALLBACK;
        const offset = Math.max(headerBottom, HEADER_HEIGHT_FALLBACK);
        const fixedIframes = document.querySelectorAll(
          'iframe[style*="position: fixed"], iframe[style*="position:fixed"]'
        );

        for (const iframe of fixedIframes) {
          const styles = window.getComputedStyle(iframe);
          const rect = iframe.getBoundingClientRect();
          const computedTop = Number.parseFloat(styles.top);
          const currentTop = Number.isFinite(computedTop) ? computedTop : rect.top;
          const zIndex = Number.parseInt(styles.zIndex, 10);

          if (
            rect.width > 0 &&
            rect.height > 0 &&
            styles.display !== 'none' &&
            styles.visibility !== 'hidden' &&
            styles.opacity !== '0' &&
            zIndex >= MONETAG_Z_INDEX_MIN &&
            currentTop >= 0 &&
            currentTop < TOP_AD_THRESHOLD
          ) {
            // Monetag can set `inset: 15px ... !important`; top must also be important.
            iframe.style.setProperty('top', `${offset}px`, 'important');
            break;
          }
        }
      };

      const observer = new MutationObserver(positionTopAd);
      observer.observe(document.documentElement, { childList: true, subtree: true });

      positionTopAd();
      const interval = window.setInterval(positionTopAd, 250);
      window.setTimeout(function() {
        window.clearInterval(interval);
      }, 5000);
    })();
  </script>

  <SiteHeader />
  <slot />
  <SiteFooter />
</body>
</html>
